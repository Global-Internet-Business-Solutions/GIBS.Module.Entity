<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.8</Version>
    <Authors>GIBS</Authors>
    <Company>GIBS</Company>
    <Description>User defined entity definitions, grouped fields, typed values, searchable, filterable metadata, and entity specific templates.</Description>
    <Product>GIBS.Module.Entity</Product>
    <Copyright>GIBS</Copyright>
    <AssemblyName>GIBS.Module.Entity.Client.Oqtane</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\GIBS.Module.Entity.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Oqtane.Client"><HintPath>..\..\oqtane.framework\Oqtane.Server\bin\Debug\net10.0\Oqtane.Client.dll</HintPath></Reference>
    <Reference Include="Oqtane.Shared"><HintPath>..\..\oqtane.framework\Oqtane.Server\bin\Debug\net10.0\Oqtane.Shared.dll</HintPath></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\GIBS.Module.Entity\EntityList.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>EntityList.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\GIBS.Module.Entity\EntityTypesEdit.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>EntityTypesEdit.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\GIBS.Module.Entity\EntityTypesIndex.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>EntityTypesIndex.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\GIBS.Module.Entity\FieldGroupsIndex.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>FieldGroupsIndex.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\GIBS.Module.Entity\FieldsIndex.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>FieldsIndex.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\GIBS.Module.Entity\TemplatesEdit.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TemplatesEdit.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\GIBS.Module.Entity\TemplatesIndex.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>TemplatesIndex.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\GIBS.Module.Entity\EntityList.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>EntityList.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\GIBS.Module.Entity\EntityTypesEdit.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>EntityTypesEdit.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\GIBS.Module.Entity\EntityTypesIndex.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>EntityTypesIndex.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\GIBS.Module.Entity\FieldGroupsIndex.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>FieldGroupsIndex.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\GIBS.Module.Entity\FieldsIndex.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>FieldsIndex.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\GIBS.Module.Entity\TemplatesEdit.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>TemplatesEdit.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\GIBS.Module.Entity\TemplatesIndex.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>TemplatesIndex.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <!-- there may be other elements here -->
    <BlazorWebAssemblyEnableLinking>false</BlazorWebAssemblyEnableLinking>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

</Project>
