@using GIBS.Module.Entity.Services
@using GIBS.Module.Entity.Models
@using GIBS.Module.Entity.Helpers

@namespace GIBS.Module.Entity
@inherits ModuleBase
@inject NavigationManager NavigationManager
@inject IEntityTemplateService EntityTemplateService
@inject IEntityTypeService EntityTypeService
@inject IEntityFieldService EntityFieldService
@inject IEntityFieldGroupService EntityFieldGroupService
@inject IStringLocalizer<TemplatesEdit> Localizer

<form @ref="form" class="@(validated ? "was-validated" : "needs-validation")" novalidate>
    <div class="container">
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="templatetype" HelpText="Template behavior type" ResourceKey="TemplateType">Template Type:</Label>
            <div class="col-sm-9">
                <select id="templatetype" class="form-select" @bind="@_templateType">
                    <option value="Listing">Listing</option>
                    <option value="Detail">Detail</option>
                    <option value="Featured">Featured</option>
                </select>
            </div>
        </div>
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="entitytypeid" HelpText="Optional entity type scope for this template" ResourceKey="EntityType">Entity Type:</Label>
            <div class="col-sm-9">
                <select id="entitytypeid" class="form-select" @bind="@_entityTypeId" @bind:after="OnEntityTypeChanged">
                    <option value="">Default (All Types)</option>
                    @foreach (var entityType in _entityTypes.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                    {
                        <option value="@entityType.EntityTypeId">@entityType.Name</option>
                    }
                </select>
            </div>
        </div>

        <hr />

        <p class="text-muted small mb-1">Available tokens for the current schema:</p>
        <div class="small mb-2">
            @foreach (var token in _availableTokens)
            {
                <code class="me-1">@token</code>
            }
        </div>
        <div class="row mb-3 align-items-start">
            <div class="col-sm-3"></div>
            <div class="col-sm-9">
                
                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="CopyTemplateTokenGuide">Copy Tokens + Field Tokens</button>
                <p class="text-muted small mt-2 mb-2">Copy combined fields and tokens to create a template for your entity items. The <code>Header</code> and <code>Footer</code> sections are rendered once, while the <code>Item</code> section is rendered for each item. The <code>Alternate</code> section is rendered for alternating items (if applicable). The <code>Separator</code> is rendered between items.</p>

                <p class="text-muted small mb-1">Available Field Keys as <code>[Field:FieldKey]</code>:</p>
                @if (_availableFieldTokens.Any())
                {
                    <div class="small mb-2">
                        @foreach (var fieldToken in _availableFieldTokens)
                        {
                            <code class="me-1">@fieldToken</code>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-2">Select an Entity Type to load field keys.</p>
                }

                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CopyFieldTokens">Copy [Field:FieldKey] Tokens</button>
            </div>
        </div>

        <div class="row mb-3 align-items-start">
            <div class="col-sm-3"></div>
            <div class="col-sm-9">
        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="CombineAndCopyCurrentValues">Combine and Copy Current Values</button>
            </div>
        </div>


        <div class="row mb-1 align-items-start">
            <Label Class="col-sm-3" For="header" HelpText="Template content rendered before items" ResourceKey="Header">Header:</Label>
            <div class="col-sm-9">
                <textarea id="header" class="form-control" @bind="@_header" rows="6"></textarea>
            </div>
        </div>
        <div class="row mb-1 align-items-start">
            <Label Class="col-sm-3" For="item" HelpText="Template content rendered for each item" ResourceKey="Item">Item:</Label>
            <div class="col-sm-9">
                <textarea id="item" class="form-control" @bind="@_item" rows="10"></textarea>
            </div>
        </div>
        @if (ShowAlternateTemplate)
        {
            <div class="row mb-1 align-items-start">
                <Label Class="col-sm-3" For="alternate" HelpText="Template content for alternating rows" ResourceKey="Alternate">Alternate:</Label>
                <div class="col-sm-9">
                    <textarea id="alternate" class="form-control" @bind="@_alternate" rows="10"></textarea>
                </div>
            </div>

        <div class="row mb-3 align-items-start">
            <Label Class="col-sm-3" For="separator" HelpText="Template content between items" ResourceKey="Separator">Separator:</Label>
            <div class="col-sm-9">
                <input id="separator" class="form-control" @bind="@_separator" maxlength="200" />
            </div>
        </div>
        }
        <div class="row mb-1 align-items-start">
            <Label Class="col-sm-3" For="footer" HelpText="Template content rendered after items" ResourceKey="Footer">Footer:</Label>
            <div class="col-sm-9">
                <textarea id="footer" class="form-control" @bind="@_footer" rows="6"></textarea>
            </div>
        </div>
        <hr />
        <div class="row mb-1 align-items-start">
            <Label Class="col-sm-3" For="pagetitle" HelpText="Optional browser title" ResourceKey="PageTitle">Page Title:</Label>
            <div class="col-sm-9">
                <input id="pagetitle" class="form-control" @bind="@_pageTitle" maxlength="200" />
            </div>
        </div>
        <div class="row mb-1 align-items-start">
            <Label Class="col-sm-3" For="pageheader" HelpText="Optional heading displayed on page" ResourceKey="PageHeader">Page Header:</Label>
            <div class="col-sm-9">
                <input id="pageheader" class="form-control" @bind="@_pageHeader" maxlength="200" />
            </div>
        </div>
        <div class="row mb-1 align-items-start">
            <Label Class="col-sm-3" For="pagedescription" HelpText="Optional meta description" ResourceKey="PageDescription">Page Description:</Label>
            <div class="col-sm-9">
                <textarea id="pagedescription" class="form-control" @bind="@_pageDescription" rows="2" maxlength="500"></textarea>
            </div>
        </div>
        <div class="row mb-1 align-items-start">
            <Label Class="col-sm-3" For="pagekeywords" HelpText="Optional meta keywords" ResourceKey="PageKeywords">Page Keywords:</Label>
            <div class="col-sm-9">
                <textarea id="pagekeywords" class="form-control" @bind="@_pageKeywords" rows="2" maxlength="500"></textarea>
            </div>
        </div>

        <br />
        <button type="button" class="btn btn-success" @onclick="SaveTemplate">@Localizer["Save"]</button>
        <NavLink class="btn btn-secondary" href="@NavigateUrl(ModuleState.ModuleId, "TemplatesIndex")">@Localizer["Cancel"]</NavLink>
        <br /><br />
        @if (_templateId != -1)
        {
            <AuditInfo CreatedBy="@_createdBy" CreatedOn="@_createdOn" ModifiedBy="@_modifiedBy" ModifiedOn="@_modifiedOn" />
        }
    </div>
</form>

@code {
    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.Edit;
    public override bool UseAdminContainer => false;
    private ElementReference form;
    private bool validated = false;

    private int _templateId = -1;
    private string _templateType = "Listing";
    private string _entityTypeId = string.Empty;
    private string _header = string.Empty;
    private string _item = string.Empty;
    private string _alternate = string.Empty;
    private string _separator = string.Empty;
    private string _footer = string.Empty;
    private string _pageTitle = string.Empty;
    private string _pageDescription = string.Empty;
    private string _pageKeywords = string.Empty;
    private string _pageHeader = string.Empty;

    private string _createdBy;
    private DateTime _createdOn;
    private string _modifiedBy;
    private DateTime _modifiedOn;
    private List<EntityType> _entityTypes = new();
    private List<string> _availableTokens = new();
    private List<string> _availableFieldTokens = new();

    private bool ShowAlternateTemplate => !string.Equals(_templateType, "Detail", StringComparison.OrdinalIgnoreCase);

    private async Task OnEntityTypeChanged()
    {
        await LoadAvailableTokensAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _entityTypes = await EntityTypeService.GetEntityTypesAsync(PageState.Site.SiteId, ModuleState.ModuleId) ?? new List<EntityType>();

            if (QueryStringHelper.TryGetInt(PageState.QueryString, "id", out _templateId) && _templateId > 0)
            {
                var template = await EntityTemplateService.GetTemplateAsync(_templateId, ModuleState.ModuleId);
                if (template != null)
                {
                    _templateType = string.IsNullOrWhiteSpace(template.TemplateType) ? "Listing" : template.TemplateType;
                    _entityTypeId = template.EntityTypeId?.ToString() ?? string.Empty;
                    _header = template.Header ?? string.Empty;
                    _item = template.Item ?? string.Empty;
                    _alternate = template.Alternate ?? string.Empty;
                    _separator = template.Separator ?? string.Empty;
                    _footer = template.Footer ?? string.Empty;
                    _pageTitle = template.PageTitle ?? string.Empty;
                    _pageDescription = template.PageDescription ?? string.Empty;
                    _pageKeywords = template.PageKeywords ?? string.Empty;
                    _pageHeader = template.PageHeader ?? string.Empty;
                    _createdBy = template.CreatedBy;
                    _createdOn = template.CreatedOn;
                    _modifiedBy = template.ModifiedBy;
                    _modifiedOn = template.ModifiedOn;
                }
            }
            else
            {
                _templateId = -1;
            }

            await LoadAvailableTokensAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Template {TemplateId} {Error}", _templateId, ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    private async Task LoadAvailableTokensAsync()
    {
        var tokens = new List<string>
        {
            "[Name]",
            "[Description]",
            "[Key]",
            "[Status]",
            "[IsFeatured]",
            "[Type]",
            "[TypeDescription]",
            "[DateCreated]",
            "[DateCreated:MM/dd/yyyy]",
            "[DateModified]",
            "[DateModified:MM/dd/yyyy]",
            "[SortOrder]",
            "[IsEnabled]",
            "[ViewCount]",
            "[Latitude]",
            "[Longitude]",
            "[Map]",
            "[Rating]",
            "[RatingCount]",
            "[CommentCount]",
            "[ViewLink]...[/ViewLink]",
            "[Edit]",
            "[HASFEATURED]...[/HASFEATURED]",
            "[HASNOTFEATURED]...[/HASNOTFEATURED]",
            "[HASIMAGES]...[/HASIMAGES]",
            "[HASNOIMAGES]...[/HASNOIMAGES]",
            "[Field:FieldKey]",
            "[CustomField:FieldKey]",
            "[Field:FieldKey:0]",
            "[Field:FieldKey:yyyy-MM-dd]",
            "[FieldList:FieldKey]",
            "[HtmlContent:FieldKey]",
            "[FieldGroup:FieldGroupKey]",
            "[FieldGroup:FieldGroupKey:Download]"
        };

        var fieldTokens = new List<string>();

        if (int.TryParse(_entityTypeId, out var entityTypeId) && entityTypeId > 0)
        {
            var fields = await EntityFieldService.GetFieldsAsync(entityTypeId, ModuleState.ModuleId) ?? new List<EntityField>();
            foreach (var field in fields.Where(f => !string.IsNullOrWhiteSpace(f.Key)).OrderBy(f => f.SortOrder).ThenBy(f => f.Name))
            {
                var fieldToken = $"[Field:{field.Key}]";
                fieldTokens.Add(fieldToken);
                tokens.Add(fieldToken);
                tokens.Add($"[CustomField:{field.Key}]");
                tokens.Add($"[Field:{field.Key}:0]");
                tokens.Add($"[Field:{field.Key}:yyyy-MM-dd]");
                tokens.Add($"[FieldList:{field.Key}]");
                tokens.Add($"[HtmlContent:{field.Key}]");
            }

            var fieldGroups = await EntityFieldGroupService.GetFieldGroupsAsync(entityTypeId, ModuleState.ModuleId) ?? new List<EntityFieldGroup>();
            foreach (var fieldGroup in fieldGroups.Where(g => !string.IsNullOrWhiteSpace(g.Key)).OrderBy(g => g.SortOrder).ThenBy(g => g.Name))
            {
                tokens.Add($"[FieldGroup:{fieldGroup.Key}]");
                tokens.Add($"[FieldGroup:{fieldGroup.Key}:Download]");
            }
        }

        _availableFieldTokens = fieldTokens
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(token => token, StringComparer.OrdinalIgnoreCase)
            .ToList();

        _availableTokens = tokens
            .Where(token => !string.IsNullOrWhiteSpace(token))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(token => token, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task CopyTemplateTokenGuide()
    {
        try
        {
            if (_availableTokens.Count == 0)
            {
                await LoadAvailableTokensAsync();
            }

            var message = string.Join(Environment.NewLine, new[]
            {
                "Template Token Reference",
                "",
                "Header and Footer render once.",
                "Item renders for each item.",
                "Alternate renders for alternating items when applicable.",
                "Separator renders between items.",
                "",
                "Available tokens:",
                string.Join(Environment.NewLine, _availableTokens)
            });

            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", message);
            AddModuleMessage("Token reference copied to clipboard.", MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error copying token reference {Error}", ex.Message);
            AddModuleMessage("Unable to copy token reference.", MessageType.Error);
        }
    }

    private async Task CopyFieldTokens()
    {
        try
        {
            if (_availableFieldTokens.Count == 0)
            {
                await LoadAvailableTokensAsync();
            }

            if (!_availableFieldTokens.Any())
            {
                AddModuleMessage("No field keys available. Select an Entity Type first.", MessageType.Warning);
                return;
            }

            var message = string.Join(Environment.NewLine, _availableFieldTokens);
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", message);
            AddModuleMessage("Field tokens copied to clipboard.", MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error copying field tokens {Error}", ex.Message);
            AddModuleMessage("Unable to copy field tokens.", MessageType.Error);
        }
    }

    private async Task CombineAndCopyCurrentValues()
    {
        try
        {
            var entityTypeName = _entityTypes
                .FirstOrDefault(x => x.EntityTypeId.ToString() == _entityTypeId)?.Name ?? "Default (All Types)";

            var sections = new List<string>
            {
                $"<!-- TemplateType: {_templateType} -->",
                $"<!-- EntityType: {entityTypeName} -->",
                "",
                "<!-- [Header] -->",
                _header ?? string.Empty,
                "",
                "<!-- [Item] -->",
                _item ?? string.Empty
            };

            if (ShowAlternateTemplate)
            {
                sections.Add("");
                sections.Add("<!-- [Alternate] -->");
                sections.Add(_alternate ?? string.Empty);
                sections.Add("");
                sections.Add("<!-- [Separator] -->");
                sections.Add(_separator ?? string.Empty);
            }

            sections.Add("");
            sections.Add("<!-- [Footer] -->");
            sections.Add(_footer ?? string.Empty);

            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", string.Join(Environment.NewLine, sections));
            AddModuleMessage("Current template values copied to clipboard.", MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error copying current template values {Error}", ex.Message);
            AddModuleMessage("Unable to copy current template values.", MessageType.Error);
        }
    }

    private async Task SaveTemplate()
    {
        validated = true;
        var interop = new Oqtane.UI.Interop(JSRuntime);
        if (await interop.FormValid(form))
        {
            try
            {
                EntityTemplate template;
                if (_templateId != -1)
                {
                    template = await EntityTemplateService.GetTemplateAsync(_templateId, ModuleState.ModuleId);
                }
                else
                {
                    template = new EntityTemplate
                    {
                        ModuleId = ModuleState.ModuleId
                    };
                }

                template.TemplateType = _templateType;
                template.EntityTypeId = int.TryParse(_entityTypeId, out var entityTypeId) ? entityTypeId : null;
                template.Header = _header;
                template.Item = _item;
                template.Alternate = _alternate;
                template.Separator = _separator;
                template.Footer = _footer;
                template.PageTitle = _pageTitle;
                template.PageDescription = _pageDescription;
                template.PageKeywords = _pageKeywords;
                template.PageHeader = _pageHeader;

                if (_templateId != -1)
                {
                    await EntityTemplateService.UpdateTemplateAsync(template);
                    await logger.LogInformation("Template Updated {Template}", template);
                }
                else
                {
                    template = await EntityTemplateService.AddTemplateAsync(template);
                    await logger.LogInformation("Template Added {Template}", template);
                }

                Index.ClearFeaturedCache(ModuleState.ModuleId);

                NavigationManager.NavigateTo(NavigateUrl(ModuleState.ModuleId, "TemplatesIndex"));
            }
            catch (Exception ex)
            {
                await logger.LogError(ex, "Error Saving Template {Error}", ex.Message);
                AddModuleMessage(Localizer["Message.SaveError"], MessageType.Error);
            }
        }
        else
        {
            AddModuleMessage(Localizer["Message.SaveValidation"], MessageType.Warning);
        }
    }
}
