@using System.IO
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using GIBS.Module.Entity.Services
@using GIBS.Module.Entity.Models

@namespace GIBS.Module.Entity
@inherits ModuleBase
@inject IEntityTypeService EntityTypeService
@inject IEntityFieldService EntityFieldService
@inject IEntityFieldGroupService EntityFieldGroupService
@inject IEntityFieldOptionService EntityFieldOptionService
@inject IEntityService EntityService
@inject IEntitySchemaPortabilityService EntitySchemaPortabilityService
@inject IEntityDataPortabilityService EntityDataPortabilityService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<BackOffice> Localizer

<div class="container-fluid">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col">
            <h2>@Localizer["BackOffice_Title"]</h2>
            <p class="text-muted">@Localizer["BackOffice_Description"]</p>
           <div class="d-flex justify-content-between">
               <NavLink class="btn btn-secondary" href="@NavigateUrl()">
                   <i class="oi oi-arrow-left"></i> @Localizer["BackToSite"]
               </NavLink>
               <div>
               <ActionLink Action="TemplatesIndex" Class="btn btn-outline-secondary" Text="Templates" Security="SecurityAccessLevel.Edit" ResourceKey="ManageTemplates" />
                    <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Add Entity" Class="btn btn-warning" ResourceKey="Add" />
               </div>
           </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-secondary">
                <div class="card-body d-flex flex-column gap-3">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button class="btn btn-outline-secondary" @onclick="ExportSchemaAsync" disabled="@_isExporting">
                            <i class="oi oi-data-transfer-download"></i> Export Schema
                        </button>
                        @if (!string.IsNullOrWhiteSpace(_exportDataUrl))
                        {
                            <a class="btn btn-secondary" href="@_exportDataUrl" download="@_exportFileName">Download Export</a>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <InputFile OnChange="OnImportFileSelected" accept=".json,application/json" class="form-control" style="max-width: 380px;" />
                        <button class="btn btn-outline-primary" @onclick="ImportSchemaAsync" disabled="@(_importFile == null || _isImporting)">
                            <i class="oi oi-data-transfer-upload"></i> Import Schema
                        </button>
                        <div class="form-check ms-2">
                            <input class="form-check-input" type="checkbox" id="overwriteExisting" @bind="_overwriteExistingImport" />
                            <label class="form-check-label" for="overwriteExisting">Overwrite existing keys</label>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_importFileName))
                    {
                        <small class="text-muted">Selected: @_importFileName</small>
                    }

                    @if (!string.IsNullOrWhiteSpace(_schemaMessage))
                    {
                        <div class="alert @(_schemaMessageIsError ? "alert-danger" : "alert-success") mb-0" role="alert">
                            @_schemaMessage
                        </div>
                    }

                    @if (_importSummary != null)
                    {
                        <div class="border rounded p-3 bg-light">
                            <h6 class="mb-2">Import Summary</h6>
                            <ul class="mb-0">
                                <li>EntityTypes: +@_importSummary.EntityTypesCreated created, @_importSummary.EntityTypesUpdated updated</li>
                                <li>FieldGroups: +@_importSummary.FieldGroupsCreated created, @_importSummary.FieldGroupsUpdated updated</li>
                                <li>CustomFields: +@_importSummary.FieldsCreated created, @_importSummary.FieldsUpdated updated</li>
                                <li>Default Templates: +@_importSummary.TemplatesCreated created, @_importSummary.TemplatesUpdated updated</li>
                                <li>Type Templates: +@_importSummary.TypeTemplatesCreated created, @_importSummary.TypeTemplatesUpdated updated</li>
                                <li>Field Options: +@_importSummary.FieldOptionsCreated created, @_importSummary.FieldOptionsUpdated updated</li>
                            </ul>
                            @if (_importSummary.Warnings.Any())
                            {
                                <div class="mt-2">
                                    <strong>Warnings</strong>
                                    <ul class="mb-0">
                                        @foreach (var warning in _importSummary.Warnings)
                                        {
                                            <li>@warning</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="card border-secondary">
                <div class="card-body d-flex flex-column gap-3">
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button class="btn btn-outline-dark" @onclick="ExportDataAsync" disabled="@_isDataExporting">
                            <i class="oi oi-cloud-download"></i> Export Records (ZIP)
                        </button>
                        @if (!string.IsNullOrWhiteSpace(_dataExportDataUrl))
                        {
                            <a class="btn btn-dark" href="@_dataExportDataUrl" download="@_dataExportFileName">Download Records ZIP</a>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <InputFile OnChange="OnDataImportFileSelected" accept=".zip,application/zip" class="form-control" style="max-width: 380px;" />
                        <button class="btn btn-outline-dark" @onclick="ImportDataAsync" disabled="@(_dataImportFile == null || _isDataImporting)">
                            <i class="oi oi-cloud-upload"></i> Import Records (ZIP)
                        </button>
                        <div class="form-check ms-2">
                            <input class="form-check-input" type="checkbox" id="overwriteExistingData" @bind="_overwriteExistingDataImport" />
                            <label class="form-check-label" for="overwriteExistingData">Overwrite existing record keys</label>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_dataImportFileName))
                    {
                        <small class="text-muted">Selected ZIP: @_dataImportFileName</small>
                    }

                    @if (!string.IsNullOrWhiteSpace(_dataMessage))
                    {
                        <div class="alert @(_dataMessageIsError ? "alert-danger" : "alert-success") mb-0" role="alert">
                            @_dataMessage
                        </div>
                    }

                    @if (_dataImportSummary != null)
                    {
                        <div class="border rounded p-3 bg-light">
                            <h6 class="mb-2">Record Import Summary</h6>
                            <ul class="mb-0">
                                <li>Records: +@_dataImportSummary.RecordsCreated created, @_dataImportSummary.RecordsUpdated updated</li>
                                <li>Values: +@_dataImportSummary.ValuesCreated created, @_dataImportSummary.ValuesUpdated replaced</li>
                                <li>Skipped: @_dataImportSummary.RecordsSkipped</li>
                            </ul>
                            @if (_dataImportSummary.Warnings.Any())
                            {
                                <div class="mt-2">
                                    <strong>Warnings</strong>
                                    <ul class="mb-0">
                                        @foreach (var warning in _dataImportSummary.Warnings)
                                        {
                                            <li>@warning</li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@Localizer["Loading"]</span>
            </div>
        </div>
    }
    else
    {
        <!-- Dashboard Statistics -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-primary mb-3">
                    <div class="card-body text-center">
                        <i class="oi oi-list-rich" style="font-size: 2rem; color: var(--bs-primary);"></i>
                        <h3 class="mt-2 mb-0">@_entityTypeCount</h3>
                        <p class="text-muted mb-0">@Localizer["CardEntityTypes"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-success mb-3">
                    <div class="card-body text-center">
                        <i class="oi oi-document" style="font-size: 2rem; color: var(--bs-success);"></i>
                        <h3 class="mt-2 mb-0">@_fieldCount</h3>
                        <p class="text-muted mb-0">@Localizer["CardFields"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-info mb-3">
                    <div class="card-body text-center">
                        <i class="oi oi-grid-three-up" style="font-size: 2rem; color: var(--bs-info);"></i>
                        <h3 class="mt-2 mb-0">@_fieldGroupCount</h3>
                        <p class="text-muted mb-0">@Localizer["CardFieldGroups"]</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-warning mb-3">
                    <div class="card-body text-center">
                        <i class="oi oi-layers" style="font-size: 2rem; color: var(--bs-warning);"></i>
                        <h3 class="mt-2 mb-0">@_entityCount</h3>
                        <p class="text-muted mb-0">@Localizer["CardEntities"]</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Management Navigation Cards -->
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-primary">
                        <h5 class="mb-0 text-white"><i class="oi oi-list-rich"></i> @Localizer["EntityTypes_Title"]</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@Localizer["EntityTypes_Description"]</p>
                        @if (_entityTypePagerItems.Any())
                        {
                            <Pager Items="@_entityTypePagerItems" PageSize="5" Class="table table-striped">
                                <Header>
                                    <th style="width: 1px;">&nbsp;</th>
                                    <th>@Localizer["Name"]</th>
                                    <th>@Localizer["Key"]</th>
                                    <th>@Localizer["SortOrder"]</th>
                                </Header>
                                <Row>
                                    <td><ActionLink Action="EntityTypesEdit" Parameters="@($"id={context.EntityType.EntityTypeId}")" IconName="oi oi-pencil" IconOnly="true" Class="btn btn-sm btn-outline-primary" ResourceKey="Edit" /></td>
                                    <td>@GetEntityTypeDisplayName(context)</td>
                                    <td><code>@context.EntityType.Key</code></td>
                                    <td>@context.EntityType.SortOrder</td>
                                </Row>
                            </Pager>
                        }
                    </div>
                    <div class="card-footer">
                        <ActionLink Action="EntityTypesIndex" Class="btn btn-primary" Text="@Localizer["Manage"]" Security="SecurityAccessLevel.Edit" ResourceKey="ManageEntityTypes" />
                        <ActionLink Action="EntityTypesEdit" Class="btn btn-outline-primary" Text="@Localizer["AddNew"]" Security="SecurityAccessLevel.Edit" ResourceKey="AddEntityType" />
                        
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-warning">
                        <h5 class="mb-0 text-white"><i class="oi oi-layers"></i> @Localizer["EntityRecords"]</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@Localizer["EntityRecordDescription"]</p>
                        @if (_entities.Any())
                        {
                            <Pager Items="@_entities" PageSize="5" Class="table table-striped">
                                <Header>
                                    <th style="width: 1px;">&nbsp;</th>
                                    <th>@Localizer["Name"]</th>
                                    <th>@Localizer["DateCreated"]</th>
                                </Header>
                                <Row>
                                    <td><ActionLink Action="Edit" Parameters="@($"id={context.EntityId}")" IconName="oi oi-pencil" IconOnly="true" Class="btn btn-sm btn-outline-warning" ResourceKey="Edit" /></td>
                                    <td>@context.Name</td>
                                    <td>@context.CreatedOn</td>
                                </Row>
                            </Pager>
                        }
                        else
                        {
                            <div class="alert alert-light mb-0" role="alert">
                                @Localizer["NoRecords"]
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        <NavLink class="btn btn-warning" href="@NavigateUrl(ModuleState.ModuleId, "EntityList")">@Localizer["Manage"]</NavLink>
                        <ActionLink Action="Add" Class="btn btn-outline-warning" Text="@Localizer["AddNew"]" Security="SecurityAccessLevel.Edit" ResourceKey="Add" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-6 offset-3">
                <div class="card">
                    <div class="card-body py-3">
                        <label class="form-label mb-2 fw-bold">@Localizer["SelectEntityType"]</label>
                        <select id="entitytypeid" class="form-select" @bind="@_selectedEntityTypeId" @bind:after="OnEntityTypeChanged" required>
                            <option value="0">-- @Localizer["SelectOne"] --</option>
                            @RenderEntityTypeOptions(_entityTypeTree, 0)
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Field Groups Management Card -->
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-info text-dark">
                        <h5 class="mb-0"><i class="oi oi-layers"></i> @Localizer["FieldGroups"]</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@Localizer["FieldGroupsDescription"]</p>
                        @if (_selectedEntityTypeId > 0)
                        {
                            var selectedFieldGroups = _fieldGroupsByEntityType.ContainsKey(_selectedEntityTypeId)
                                ? _fieldGroupsByEntityType[_selectedEntityTypeId]
                                : new List<EntityFieldGroup>();

                            if (selectedFieldGroups.Any())
                            {
                                <Pager Items="@selectedFieldGroups" PageSize="5" Class="table table-striped">
                                    <Header>
                                        <th style="width: 1px;">&nbsp;</th>
                                        <th>@Localizer["Name"]</th>
                                        <th>@Localizer["Key"]</th>
                                    </Header>
                                    <Row>
                                        <td><ActionLink Action="FieldGroupsEdit" Parameters="@($"id={context.FieldGroupId}&entitytypeid={_selectedEntityTypeId}")" IconName="oi oi-pencil" IconOnly="true" Class="btn btn-sm btn-outline-info" ResourceKey="Edit" /></td>
                                        <td>@context.Name</td>
                                        <td><code>@context.Key</code></td>
                                    </Row>
                                </Pager>
                            }
                            else
                            {
                                <div class="alert alert-light mb-0" role="alert">
                                    @Localizer["NoFieldGroups"]
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-light mb-0" role="alert">
                                @Localizer["SelectEntityType"]
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        @if (_selectedEntityTypeId > 0)
                        {
                            <ActionLink Action="FieldGroupsIndex" Parameters="@($"entitytypeid={_selectedEntityTypeId}")" Class="btn btn-info" Text="@Localizer["Manage"]" Security="SecurityAccessLevel.Edit" ResourceKey="ManageFieldGroups" />
                            <ActionLink Action="FieldGroupsEdit" Parameters="@($"entitytypeid={_selectedEntityTypeId}")" Class="btn btn-outline-info" Text="@Localizer["AddNew"]" Security="SecurityAccessLevel.Edit" ResourceKey="AddFieldGroup" />
                        }
                        else
                        {
                            <button class="btn btn-info" disabled>@Localizer["Manage"]</button>
                            <button class="btn btn-outline-info" disabled>@Localizer["AddNew"]</button>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-header bg-success">
                        <h5 class="mb-0 text-white"><i class="oi oi-document"></i> @Localizer["Fields_Title"]</h5>
                    </div>
                    <div class="card-body">
                        <p class="card-text">@Localizer["Fields_Description"]</p>
                        @if (_selectedEntityTypeId > 0)
                        {
                            var selectedFields = _fieldsByEntityType.ContainsKey(_selectedEntityTypeId)
                                ? _fieldsByEntityType[_selectedEntityTypeId]
                                : new List<EntityField>();

                            if (selectedFields.Any())
                            {
                                <Pager Items="@selectedFields" PageSize="5" Class="table table-striped">
                                    <Header>
                                        <th style="width: 1px;">&nbsp;</th>
                                        <th>@Localizer["Name"]</th>
                                        <th>@Localizer["Key"]</th>
                                    </Header>
                                    <Row>
                                        <td><ActionLink Action="FieldsEdit" Parameters="@($"id={context.FieldId}&entitytypeid={_selectedEntityTypeId}")" IconName="oi oi-pencil" IconOnly="true" Class="btn btn-sm btn-outline-success" ResourceKey="Edit" /></td>
                                        <td>@context.Name</td>
                                        <td><code>@context.Key</code></td>
                                    </Row>
                                </Pager>
                            }
                            else
                            {
                                <div class="alert alert-light mb-0" role="alert">
                                    @Localizer["Message.DisplayNone"]
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-light mb-0" role="alert">
                                @Localizer["SelectEntityType"]
                            </div>
                        }
                    </div>
                    <div class="card-footer">
                        @if (_selectedEntityTypeId > 0)
                        {
                            <ActionLink Action="FieldsIndex" Parameters="@($"entitytypeid={_selectedEntityTypeId}")" Class="btn btn-success" Text="@Localizer["Manage"]" Security="SecurityAccessLevel.Edit" ResourceKey="ManageFields" />
                            <ActionLink Action="FieldsEdit" Parameters="@($"entitytypeid={_selectedEntityTypeId}")" Class="btn btn-outline-success" Text="@Localizer["AddNew"]" Security="SecurityAccessLevel.Edit" ResourceKey="AddField" />
                        }
                        else
                        {
                            <button class="btn btn-success" disabled>@Localizer["Manage"]</button>
                            <button class="btn btn-outline-success" disabled>@Localizer["AddNew"]</button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Entity Types -->
        @if (_entityTypes.Any())
        {
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0"><i class="oi oi-list"></i> @Localizer["RecentEntityTypes"]</h5>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>@Localizer["Name"]</th>
                                            <th>@Localizer["Key"]</th>
                                            <th>@Localizer["Fields"]</th>
                                            <th>@Localizer["Status"]</th>
                                            <th>@Localizer["Modified"]</th>
                                            <th>@Localizer["Actions"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var entityType in _entityTypes.Take(5))
                                        {
                                            var fieldCount = _fieldCounts.ContainsKey(entityType.EntityTypeId) ? _fieldCounts[entityType.EntityTypeId] : 0;
                                            <tr>
                                                <td>
                                                    <strong>@entityType.Name</strong>
                                                    @if (entityType.IsSystem)
                                                    {
                                                        <span class="badge bg-secondary ms-1">@Localizer["System"]</span>
                                                    }
                                                </td>
                                                <td><code>@entityType.Key</code></td>
                                                <td>
                                                    <span class="badge bg-info">@fieldCount @Localizer["FieldsCount"]</span>
                                                </td>
                                                <td>
                                                    @if (entityType.IsEnabled)
                                                    {
                                                        <span class="badge bg-success">@Localizer["Enabled"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">@Localizer["Disabled"]</span>
                                                    }
                                                </td>
                                                <td>
                                                    <small class="text-muted">@entityType.ModifiedOn.ToString("g")</small>
                                                </td>
                                                <td>
                                                    <ActionLink Action="EntityTypesEdit" Parameters="@($"id={entityType.EntityTypeId}")" Class="btn btn-sm btn-outline-primary" Text="@Localizer["Edit"]" Security="SecurityAccessLevel.Edit" ResourceKey="Edit" />
                                                    <ActionLink Action="FieldsIndex" Parameters="@($"entitytypeid={entityType.EntityTypeId}")" Class="btn btn-sm btn-outline-success" Text="@Localizer["Fields"]" Security="SecurityAccessLevel.Edit" ResourceKey="Fields" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (_entityTypes.Count > 5)
                            {
                                <div class="text-center mt-3">
                                    <ActionLink Action="EntityTypesIndex" Class="btn btn-outline-primary" Text="@Localizer["ViewAll"]" Security="SecurityAccessLevel.Edit" ResourceKey="ViewAllEntityTypes" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Getting Started Guide -->
            <div class="row">
                <div class="col-12">
                    <div class="card border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="oi oi-lightbulb"></i> @Localizer["GettingStarted.Title"]</h5>
                        </div>
                        <div class="card-body">
                            <h6>@Localizer["GettingStarted.Welcome"]</h6>
                            <ol class="mt-3">
                                <li class="mb-2">
                                    <strong>@Localizer["GettingStarted.Step1.Title"]</strong>
                                    <p class="text-muted mb-0">@Localizer["GettingStarted.Step1.Description"]</p>
                                </li>
                                <li class="mb-2">
                                    <strong>@Localizer["GettingStarted.Step2.Title"]</strong>
                                    <p class="text-muted mb-0">@Localizer["GettingStarted.Step2.Description"]</p>
                                </li>
                                <li class="mb-2">
                                    <strong>@Localizer["GettingStarted.Step3.Title"]</strong>
                                    <p class="text-muted mb-0">@Localizer["GettingStarted.Step3.Description"]</p>
                                </li>
                                <li class="mb-2">
                                    <strong>@Localizer["GettingStarted.Step4.Title"]</strong>
                                    <p class="text-muted mb-0">@Localizer["GettingStarted.Step4.Description"]</p>
                                </li>
                            </ol>
                            <div class="alert alert-info mt-3" role="alert">
                                <i class="oi oi-info"></i> @Localizer["GettingStarted.Tip"]
                            </div>
                            <ActionLink Action="EntityTypesEdit" Class="btn btn-primary btn-lg" Text="@Localizer["CreateFirstEntityType"]" Security="SecurityAccessLevel.Edit" ResourceKey="CreateFirstEntityType" />
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    public override string RenderMode => RenderModes.Interactive;
    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.Edit;
    public override bool UseAdminContainer => false;
    private bool _isLoading = true;
    private int _entityTypeCount = 0;
    private int _fieldCount = 0;
    private int _fieldGroupCount = 0;
    private int _entityCount = 0;
    private List<EntityType> _entityTypes = new();
    private List<EntityType> _entityTypeTree = new();
    private List<EntityTypePagerItem> _entityTypePagerItems = new();
    private List<Entity> _entities = new();
    private Dictionary<int, int> _fieldCounts = new();
    private Dictionary<int, List<EntityFieldGroup>> _fieldGroupsByEntityType = new();
    private Dictionary<int, List<EntityField>> _fieldsByEntityType = new();
    private int _selectedEntityTypeId = 0;
    private IBrowserFile _importFile;
    private string _importFileName;
    private bool _overwriteExistingImport = true;
    private bool _isImporting;
    private bool _isExporting;
    private string _schemaMessage;
    private bool _schemaMessageIsError;
    private EntitySchemaImportResult _importSummary;
    private string _exportDataUrl;
    private string _exportFileName;

    private IBrowserFile _dataImportFile;
    private string _dataImportFileName;
    private bool _overwriteExistingDataImport = true;
    private bool _isDataImporting;
    private bool _isDataExporting;
    private string _dataMessage;
    private bool _dataMessageIsError;
    private EntityDataImportResult _dataImportSummary;
    private string _dataExportDataUrl;
    private string _dataExportFileName;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isLoading = true;

            // Load statistics
            _entityTypes = await EntityTypeService.GetEntityTypesAsync(PageState.Site.SiteId, ModuleState.ModuleId);
            _entityTypeCount = _entityTypes.Count;
            _entityTypeTree = BuildEntityTypeTree(_entityTypes);
            _entityTypePagerItems = FlattenEntityTypeTree(_entityTypeTree);
            _selectedEntityTypeId = _entityTypes.FirstOrDefault()?.EntityTypeId ?? 0;

            // Load field groups count and cache by entity type
            var allFieldGroups = new List<EntityFieldGroup>();
            foreach (var entityType in _entityTypes)
            {
                var groups = await EntityFieldGroupService.GetFieldGroupsAsync(entityType.EntityTypeId, ModuleState.ModuleId);
                _fieldGroupsByEntityType[entityType.EntityTypeId] = groups ?? new List<EntityFieldGroup>();
                allFieldGroups.AddRange(_fieldGroupsByEntityType[entityType.EntityTypeId]);
            }
            _fieldGroupCount = allFieldGroups.Count;

            // Load fields count per entity type
            foreach (var entityType in _entityTypes)
            {
                var fields = await EntityFieldService.GetFieldsAsync(entityType.EntityTypeId, ModuleState.ModuleId);
                _fieldsByEntityType[entityType.EntityTypeId] = fields ?? new List<EntityField>();
                _fieldCounts[entityType.EntityTypeId] = _fieldsByEntityType[entityType.EntityTypeId].Count;
                _fieldCount += _fieldsByEntityType[entityType.EntityTypeId].Count;
            }

            // Load entities count
            _entities = (await EntityService.GetEntitysAsync(ModuleState.ModuleId) ?? new List<Entity>())
                .OrderByDescending(x => x.CreatedOn)
                .ToList();
            _entityCount = _entities.Count;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading BackOffice Data {Error}", ex.Message);
            AddModuleMessage(Localizer["Error.LoadData"], MessageType.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

