    private List<EntityType> BuildEntityTypeTree(List<EntityType> flatList)
    {
        foreach (var item in flatList)
        {
            item.Children = new List<EntityType>();
        }

        var lookup = flatList.ToDictionary(x => x.EntityTypeId);
        var rootItems = new List<EntityType>();

        foreach (var item in flatList)
        {
            if (item.ParentEntityTypeId == null || !lookup.ContainsKey(item.ParentEntityTypeId.Value))
            {
                rootItems.Add(item);
            }
            else
            {
                lookup[item.ParentEntityTypeId.Value].Children.Add(item);
            }
        }

        SortEntityTypes(rootItems);
        return rootItems;
    }

    private void SortEntityTypes(List<EntityType> items)
    {
        items.Sort((a, b) => a.SortOrder.CompareTo(b.SortOrder));
        foreach (var item in items)
        {
            if (item.Children != null && item.Children.Count > 0)
            {
                SortEntityTypes(item.Children);
            }
        }
    }

    private List<EntityTypePagerItem> FlattenEntityTypeTree(IEnumerable<EntityType> items, int level = 0)
    {
        var result = new List<EntityTypePagerItem>();
        foreach (var item in items.OrderBy(x => x.SortOrder))
        {
            result.Add(new EntityTypePagerItem
            {
                EntityType = item,
                Level = level
            });

            if (item.Children != null && item.Children.Count > 0)
            {
                result.AddRange(FlattenEntityTypeTree(item.Children, level + 1));
            }
        }

        return result;
    }

    private string GetEntityTypeDisplayName(EntityTypePagerItem item)
    {
        if (item == null || item.EntityType == null)
        {
            return string.Empty;
        }

        var prefix = item.Level > 0 ? string.Concat(Enumerable.Repeat("— ", item.Level)) : string.Empty;
        return $"{prefix}{item.EntityType.Name}";
    }

    private sealed class EntityTypePagerItem
    {
        public EntityType EntityType { get; set; }
        public int Level { get; set; }
    }

    private RenderFragment RenderEntityTypeOptions(IEnumerable<EntityType> items, int level = 0) => builder =>
    {
        int seq = 0;
        foreach (var item in items)
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", item.EntityTypeId);
            builder.AddContent(seq++, new string('\u00A0', level * 4) + item.Name);
            builder.CloseElement();

            if (item.Children != null && item.Children.Count > 0)
            {
                builder.AddContent(seq++, RenderEntityTypeOptions(item.Children, level + 1));
            }
        }
    };
}
