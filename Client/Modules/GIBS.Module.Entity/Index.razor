@using GIBS.Module.Entity.Services
@using GIBS.Module.Entity.Models
@using GIBS.Module.Entity.Helpers

@namespace GIBS.Module.Entity
@inherits ModuleBase
@inject IEntityTypeService EntityTypeService
@inject IEntityFieldService EntityFieldService
@inject IEntityFieldGroupService EntityFieldGroupService
@inject IEntityFieldOptionService EntityFieldOptionService
@inject IEntityService EntityService
@inject IEntityTemplateService EntityTemplateService
@inject IEntityValueService EntityValueService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer
@inject ISettingService SettingService

<div class="container">
    <div class="row mb-3">
        <div class="col">
           @if(!string.IsNullOrEmpty(_customTitle))
            {
                <h3>@_customTitle</h3>
            }
           
        </div>
    </div>
    <div class="row mb-3">
        <div class="col text-end">
           
            <ActionLink Action="EntityList" Security="SecurityAccessLevel.Edit" IconName="oi oi-list" IconOnly="false" Text="Entity List" Class="btn btn-primary" ResourceKey="EntityList" />
            <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Add Entity" IconName="oi oi-plus" IconOnly="true" Class="btn btn-primary" ResourceKey="AddEntity" />
            <ActionLink Action="BackOffice" Security="SecurityAccessLevel.Edit" Text="Back Office" Class="btn btn-info" ResourceKey="BackOffice" />
        </div>
    </div>


    <div class="row align-items-center">
        <div class="col-md-9 align-self-start" style="border: 0px solid #ff5733; padding: 1rem;">
            @if (_showDetail && _recordDetails != null && _detailTemplate != null)
            {
                var detailValues = _recordDetailValuesMap.ContainsKey(_recordDetails.EntityId)
                    ? _recordDetailValuesMap[_recordDetails.EntityId]
                    : new List<EntityValue>();

                @if (!string.IsNullOrEmpty(_detailTemplate.Header))
                {
                    @((MarkupString)TemplateEngine.Render(_detailTemplate.Header, _recordDetails, _entityFields, detailValues, BuildCurrentPageUrl(), GetEditBaseUrl(), _entityFieldGroups))
                }

                @if (!string.IsNullOrEmpty(_detailTemplate.Item))
                {
                    @((MarkupString)TemplateEngine.Render(_detailTemplate.Item, _recordDetails, _entityFields, detailValues, BuildCurrentPageUrl(), GetEditBaseUrl(), _entityFieldGroups))
                }

                @if (!string.IsNullOrEmpty(_detailTemplate.Footer))
                {
                    @((MarkupString)TemplateEngine.Render(_detailTemplate.Footer, _recordDetails, _entityFields, detailValues, BuildCurrentPageUrl(), GetEditBaseUrl(), _entityFieldGroups))
                }
            }
            else if (_showListing)
            {
                @if (_sortingOptions.Any())
                {
                    <form method="get" action="@BuildCurrentPageUrl()" class="mb-3 d-flex justify-content-end gap-2">
                        <input type="hidden" name="type" value="@_selectedEntityTypeKey" />
                        <div>
                            <label class="me-2">Sort By:</label>
                            <select name="sortby" class="form-select d-inline-block w-auto" onchange="this.form.submit()">
                                @foreach (var option in _sortingOptions)
                                {
                                    <option value="@option.Key" selected="@string.Equals(_selectedSortFieldKey, option.Key, StringComparison.OrdinalIgnoreCase)">@option.Label</option>
                                }
                            </select>
                        </div>
                        <div>
                            <select name="sortdir" class="form-select d-inline-block w-auto" onchange="this.form.submit()">
                                <option value="Ascending" selected="@string.Equals(_selectedSortDirection, "Ascending", StringComparison.OrdinalIgnoreCase)">Ascending</option>
                                <option value="Descending" selected="@string.Equals(_selectedSortDirection, "Descending", StringComparison.OrdinalIgnoreCase)">Descending</option>
                            </select>
                        </div>
                    </form>
                }

                @if (_listingRecords != null && _listingRecords.Any())
                {
                    @if (!string.IsNullOrEmpty(_listingTemplate?.Header))
                    {
                        @((MarkupString)RenderTemplateSection(_listingTemplate.Header))
                    }

                    {
                        int count = 0;

                        foreach (var record in _listingRecords)
                        {
                            var recordTemplate = ResolveTemplate(_listingTemplates, "Listing", record.EntityTypeId);
                            var templateContent = (count % 2 == 0)
                                ? recordTemplate?.Item
                                : recordTemplate?.Alternate ?? recordTemplate?.Item;

                            if (!string.IsNullOrEmpty(templateContent))
                            {
                                var entityValues = _listingEntityValuesMap.ContainsKey(record.EntityId)
                                    ? _listingEntityValuesMap[record.EntityId]
                                    : new List<EntityValue>();

                                var rendered = TemplateEngine.Render(templateContent, record, _entityFields, entityValues, BuildCurrentPageUrl(), GetEditBaseUrl(), _entityFieldGroups);
                                @((MarkupString)rendered)
                            }

                            if (!string.IsNullOrEmpty(_listingTemplate?.Separator) && count < _listingRecords.Count - 1)
                            {
                                @((MarkupString)_listingTemplate.Separator)
                            }

                            count++;
                        }
                    }

                    @if (!string.IsNullOrEmpty(_listingTemplate?.Footer))
                    {
                        @((MarkupString)RenderTemplateSection(_listingTemplate.Footer))
                    }
                }
            }
            else if (_enableFeatured && _featuredRecords != null && _featuredRecords.Any())
            {
                @if (!string.IsNullOrEmpty(_featuredTemplate?.Header))
                {
                    @((MarkupString)_featuredTemplate.Header)
                }

                {
                    int count = 0;

                    foreach (var record in _featuredRecords)
                    {
                        var recordTemplate = ResolveTemplate(_featuredTemplates, "Featured", record.EntityTypeId);
                        var templateContent = (count % 2 == 0)
                            ? recordTemplate?.Item
                            : recordTemplate?.Alternate ?? recordTemplate?.Item;

                        if (!string.IsNullOrEmpty(templateContent))
                        {
                            var entityValues = _entityValuesMap.ContainsKey(record.EntityId)
                                ? _entityValuesMap[record.EntityId]
                                : new List<EntityValue>();

                            var rendered = TemplateEngine.Render(templateContent, record, _entityFields, entityValues, BuildCurrentPageUrl(), GetEditBaseUrl(), _entityFieldGroups);
                            @((MarkupString)rendered)
                        }

                        if (!string.IsNullOrEmpty(_featuredTemplate?.Separator) && count < _featuredRecords.Count - 1)
                        {
                            @((MarkupString)_featuredTemplate.Separator)
                        }

                        count++;
                    }
                }

                @if (!string.IsNullOrEmpty(_featuredTemplate?.Footer))
                {
                    @((MarkupString)_featuredTemplate.Footer)
                }
            }
        </div>
        <div class="col-md-3 align-self-start" style="border: 0px solid #ff5733; padding: 1rem;">
            @if (_entityTypeTree.Any())
            {
                <nav class="entitytype-nav" aria-label="Browse by Entity Type">
                   
                    <ul class="list-unstyled mb-2">
                        <li>
                            <a href="@GetEntityListUrl()">@Localizer["EntityList"]</a>
                        </li>
                    </ul>
                    @RenderEntityTypeNavigation(_entityTypeTree)
                </nav>
            }
        </div>
    </div>

</div>


@code {
    public override string RenderMode => RenderModes.Static;
    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.View;
    public override bool UseAdminContainer => false;
    public override string Title => _pageTitle;

    private bool _isLoading = true;
    private string _customTitle;
    private string _pageTitle = string.Empty;
    private bool _enableFeatured;
    private bool _showDetail;
    private bool _showListing;
    private string _selectedEntityTypeName;
    private string _selectedEntityTypeKey;
    private Entity _recordDetails;
    private EntityTemplate _detailTemplate;
    private Dictionary<int, List<EntityValue>> _recordDetailValuesMap = new();
    private List<Entity> _featuredRecords = new();
    private EntityTemplate _featuredTemplate;
    private List<EntityTemplate> _featuredTemplates = new();
    private List<Entity> _listingRecords = new();
    private EntityTemplate _listingTemplate;
    private List<EntityTemplate> _listingTemplates = new();
    private List<EntityField> _entityFields = new();
    private List<EntityFieldGroup> _entityFieldGroups = new();
    private Dictionary<int, List<EntityValue>> _entityValuesMap = new();
    private Dictionary<int, List<EntityValue>> _listingEntityValuesMap = new();
    private List<EntityType> _entityTypeTree = new();
    private Dictionary<int, EntityType> _entityTypeLookup = new();
    private List<(string Key, string Label)> _sortingOptions = new();
    private string _selectedSortFieldKey = "LastModified";
    private string _selectedSortDirection = "Ascending";

    // Cache for featured data - persists across component instances
    private static readonly Dictionary<string, FeaturedDataCache> _cache = new();

    private class FeaturedDataCache
    {
        public List<Entity> FeaturedRecords { get; set; }
        public EntityTemplate FeaturedTemplate { get; set; }
        public List<EntityTemplate> FeaturedTemplates { get; set; }
        public List<EntityField> EntityFields { get; set; }
        public List<EntityFieldGroup> FieldGroups { get; set; }
        public Dictionary<int, List<EntityValue>> EntityValuesMap { get; set; }
    }

    /// <summary>
    /// Public static method to clear featured cache for a specific module.
    /// Call this from EntityEdit or other components when featured data changes.
    /// </summary>
    public static void ClearFeaturedCache(int moduleId)
    {
        string cacheKey = $"FeaturedData_{moduleId}";
        if (_cache.ContainsKey(cacheKey))
        {
            _cache.Remove(cacheKey);
        }
    }

    /// <summary>
    /// Public static method to clear all featured caches.
    /// Use when you want to force refresh across all modules.
    /// </summary>
    public static void ClearAllFeaturedCaches()
    {
        _cache.Clear();
    }

        protected override async Task OnInitializedAsync()
    {
        try
        {
           _isLoading = true;

            _customTitle = SettingService.GetSetting(ModuleState.Settings, "CustomTitle", "");
            _pageTitle = _customTitle;
            _enableFeatured = bool.TryParse(SettingService.GetSetting(ModuleState.Settings, "EnableFeatured", "true"), out var enableFeatured) && enableFeatured;

            var entityTypes = await EntityTypeService.GetEntityTypesAsync(PageState.Site.SiteId, ModuleState.ModuleId);
            var allEntityTypes = entityTypes ?? new List<EntityType>();
            _entityTypeLookup = allEntityTypes.ToDictionary(x => x.EntityTypeId, x => x);
            _entityTypeTree = BuildEntityTypeTree(allEntityTypes);

            var requestedDetailKey = GetQueryValue("detail");
            _showDetail = !string.IsNullOrWhiteSpace(requestedDetailKey);

            if (_showDetail)
            {
                await LoadRecordDetailsAsync(requestedDetailKey);
            }
            else
            {
                var requestedTypeKey = GetQueryValue("type");
                _showListing = !string.IsNullOrWhiteSpace(requestedTypeKey);

                if (_showListing)
                {
                    var selectedEntityType = allEntityTypes.FirstOrDefault(x => string.Equals(x.Key, requestedTypeKey, StringComparison.OrdinalIgnoreCase));
                    if (selectedEntityType != null)
                    {
                        _selectedEntityTypeName = selectedEntityType.Name;
                        _selectedEntityTypeKey = selectedEntityType.Key;

                        var requestedSortBy = GetQueryValue("sortby");
                        _selectedSortFieldKey = string.IsNullOrWhiteSpace(requestedSortBy) ? "LastModified" : requestedSortBy;

                        var requestedSortDirection = GetQueryValue("sortdir");
                        _selectedSortDirection = string.Equals(requestedSortDirection, "Descending", StringComparison.OrdinalIgnoreCase)
                            ? "Descending"
                            : "Ascending";

                        await LoadListingRecordsAsync(selectedEntityType.EntityTypeId, allEntityTypes);
                    }
                }
            }

            if (!_showDetail && !_showListing && _enableFeatured)
            {
                // Use cache key based on ModuleId so each module instance has its own cache
                string cacheKey = $"FeaturedData_{ModuleState.ModuleId}";

                if (_cache.ContainsKey(cacheKey))
                {
                    // Use cached data from previous render
                    var cached = _cache[cacheKey];
                    _featuredRecords = cached.FeaturedRecords;
                    _featuredTemplate = cached.FeaturedTemplate;
                    _featuredTemplates = cached.FeaturedTemplates ?? new List<EntityTemplate>();
                    _entityFields = cached.EntityFields;
                    _entityFieldGroups = cached.FieldGroups ?? new List<EntityFieldGroup>();
                    _entityValuesMap = cached.EntityValuesMap;
                    await logger.LogDebug($"Cache HIT: Loaded {_featuredRecords.Count} featured records from cache");
                }
                else
                {
                    // First time: load data and cache for Static renders
                    await LoadFeaturedRecordsAsync();
                    await logger.LogDebug($"Cache MISS: Loaded {_featuredRecords.Count} featured records from API");

                    // Cache the data so subsequent Static renders use it
                    _cache[cacheKey] = new FeaturedDataCache
                    {
                        FeaturedRecords = new List<Entity>(_featuredRecords),
                        FeaturedTemplate = _featuredTemplate,
                        FeaturedTemplates = new List<EntityTemplate>(_featuredTemplates),
                        EntityFields = new List<EntityField>(_entityFields),
                        FieldGroups = new List<EntityFieldGroup>(_entityFieldGroups),
                        EntityValuesMap = new Dictionary<int, List<EntityValue>>(_entityValuesMap)
                    };
                }

                ApplyFeaturedPageTitle();
            }





            
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading BackOffice Data {Error}", ex.Message);
            AddModuleMessage(Localizer["Error.LoadData"], MessageType.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadFeaturedRecordsAsync()
    {
        try
        {
            // Clear previous data
            _featuredRecords.Clear();
            _featuredTemplates.Clear();
            _featuredTemplate = null;
            _entityFields.Clear();
            _entityValuesMap.Clear();

            var templates = await EntityTemplateService.GetTemplatesAsync(ModuleState.ModuleId);
            _featuredTemplates = (templates ?? new List<EntityTemplate>())
                .Where(t => string.Equals(t.TemplateType, "Featured", StringComparison.OrdinalIgnoreCase))
                .OrderBy(t => t.TemplateId)
                .ToList();
            _featuredTemplate = ResolveDefaultTemplate(_featuredTemplates);

            if (!_featuredTemplates.Any())
            {
                return;
            }

            // Get featured entities ordered by SortOrder
            var entities = await EntityService.GetEntitysAsync(ModuleState.ModuleId);
            _featuredRecords = (entities ?? new List<Entity>())
                .Where(e => e.IsFeatured && e.IsEnabled && e.IsPublished)
                .OrderBy(e => e.SortOrder)
                .ToList();
            EnsureEntityTypeReferences(_featuredRecords);

            if (_featuredRecords.Any())
            {
                var templateData = await LoadEntityFieldsAndValuesAsync(_featuredRecords);
                _entityFields = templateData.Fields;
                _entityFieldGroups = templateData.FieldGroups;
                _entityValuesMap = templateData.EntityValuesMap;
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Featured Records {Error}", ex.Message);
        }
    }

    private void ApplyFeaturedPageTitle()
    {
        if (string.IsNullOrWhiteSpace(_featuredTemplate?.PageTitle))
        {
            return;
        }

        if (_featuredRecords.Any())
        {
            var featuredRecord = _featuredRecords.First();
            var featuredValues = _entityValuesMap.TryGetValue(featuredRecord.EntityId, out var values)
                ? values
                : new List<EntityValue>();

            _pageTitle = TemplateEngine.Render(_featuredTemplate.PageTitle, featuredRecord, _entityFields, featuredValues, BuildCurrentPageUrl(), GetEditBaseUrl(), _entityFieldGroups);
        }
        else
        {
            _pageTitle = _featuredTemplate.PageTitle;
        }

        SetPageTitle(_pageTitle);
    }

    private async Task LoadRecordDetailsAsync(string detailKey)
    {
        try
        {
            _recordDetails = null;
            _detailTemplate = null;
            _recordDetailValuesMap.Clear();

            var entities = await EntityService.GetEntitysAsync(ModuleState.ModuleId);
            _recordDetails = (entities ?? new List<Entity>())
                .FirstOrDefault(e => e.IsEnabled && e.IsPublished && string.Equals(e.Key, detailKey, StringComparison.OrdinalIgnoreCase));
            EnsureEntityTypeReference(_recordDetails);

            if (_recordDetails == null)
            {
                return;
            }

            var templates = await EntityTemplateService.GetTemplatesAsync(ModuleState.ModuleId);
            _detailTemplate = ResolveTemplate(templates, "Detail", _recordDetails.EntityTypeId);

            if (_detailTemplate != null)
            {
                var templateData = await LoadEntityFieldsAndValuesAsync(new List<Entity> { _recordDetails });
                _entityFields = templateData.Fields;
                _entityFieldGroups = templateData.FieldGroups;
                _recordDetailValuesMap = templateData.EntityValuesMap;

                if (!string.IsNullOrWhiteSpace(_detailTemplate.PageTitle))
                {
                    var detailValues = _recordDetailValuesMap.TryGetValue(_recordDetails.EntityId, out var values)
                        ? values
                        : new List<EntityValue>();

                    _pageTitle = TemplateEngine.Render(_detailTemplate.PageTitle, _recordDetails, _entityFields, detailValues, BuildCurrentPageUrl(), GetEditBaseUrl(), _entityFieldGroups);
                    SetPageTitle(_pageTitle);
                }
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Record Details {Error}", ex.Message);
        }
    }

    private async Task LoadListingRecordsAsync(int entityTypeId, List<EntityType> allEntityTypes)
    {
        try
        {
            _listingRecords.Clear();
            _listingTemplates.Clear();
            _listingTemplate = null;
            _listingEntityValuesMap.Clear();

            var templates = await EntityTemplateService.GetTemplatesAsync(ModuleState.ModuleId);
            _listingTemplates = (templates ?? new List<EntityTemplate>())
                .Where(t => string.Equals(t.TemplateType, "Listing", StringComparison.OrdinalIgnoreCase))
                .OrderBy(t => t.TemplateId)
                .ToList();
            _listingTemplate = ResolveTemplate(_listingTemplates, "Listing", entityTypeId);

            if (!string.IsNullOrWhiteSpace(_listingTemplate?.PageTitle))
            {
                _pageTitle = RenderTemplateSection(_listingTemplate.PageTitle);
                SetPageTitle(_pageTitle);
            }

            if (!_listingTemplates.Any())
            {
                return;
            }

            var selectedTypeIds = GetEntityTypeAndDescendantIds(entityTypeId, allEntityTypes ?? new List<EntityType>());
            var entities = await EntityService.GetEntitysAsync(ModuleState.ModuleId);
            _listingRecords = (entities ?? new List<Entity>())
                .Where(e => selectedTypeIds.Contains(e.EntityTypeId) && e.IsEnabled && e.IsPublished)
                .OrderBy(e => e.SortOrder)
                .ToList();
            EnsureEntityTypeReferences(_listingRecords);

            if (_listingRecords.Any())
            {
                var templateData = await LoadEntityFieldsAndValuesAsync(_listingRecords);
                _entityFields = templateData.Fields;
                _entityFieldGroups = templateData.FieldGroups;
                _listingEntityValuesMap = templateData.EntityValuesMap;
                BuildSortingOptions();
                ApplyListingSort();
            }
            else
            {
                _sortingOptions.Clear();
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Listing Records {Error}", ex.Message);
        }
    }

    private async Task<(List<EntityField> Fields, List<EntityFieldGroup> FieldGroups, Dictionary<int, List<EntityValue>> EntityValuesMap)> LoadEntityFieldsAndValuesAsync(List<Entity> records)
    {
        if (_entityTypeLookup.Count == 0)
        {
            var allEntityTypes = await EntityTypeService.GetEntityTypesAsync(PageState.Site.SiteId, ModuleState.ModuleId);
            _entityTypeLookup = (allEntityTypes ?? new List<EntityType>()).ToDictionary(x => x.EntityTypeId, x => x);
        }

        var entityTypeIds = records.Select(e => e.EntityTypeId).Distinct();
        var fieldsByKey = new Dictionary<string, EntityField>(StringComparer.OrdinalIgnoreCase);
        var fieldGroupsByKey = new Dictionary<string, EntityFieldGroup>(StringComparer.OrdinalIgnoreCase);
        var entityValuesMap = new Dictionary<int, List<EntityValue>>();

        foreach (var typeId in entityTypeIds)
        {
            var effectiveTypeIds = GetEffectiveEntityTypeIds(typeId, _entityTypeLookup);
            foreach (var effectiveTypeId in effectiveTypeIds)
            {
                var fields = await EntityFieldService.GetFieldsAsync(effectiveTypeId, ModuleState.ModuleId);
                foreach (var field in (fields ?? new List<EntityField>()).Where(f => f.IsEnabled))
                {
                    if (!string.IsNullOrWhiteSpace(field.Key) && !fieldsByKey.ContainsKey(field.Key))
                    {
                        fieldsByKey[field.Key] = field;
                    }
                }

                var fieldGroups = await EntityFieldGroupService.GetFieldGroupsAsync(effectiveTypeId, ModuleState.ModuleId);
                foreach (var fieldGroup in (fieldGroups ?? new List<EntityFieldGroup>()).Where(g => g.IsEnabled && !string.IsNullOrWhiteSpace(g.Key)))
                {
                    if (!fieldGroupsByKey.ContainsKey(fieldGroup.Key))
                    {
                        fieldGroupsByKey[fieldGroup.Key] = fieldGroup;
                    }
                }
            }
        }

        foreach (var record in records)
        {
            var entityValues = await EntityValueService.GetAllEntityValuesAsync(record.EntityId);
            entityValuesMap[record.EntityId] = entityValues ?? new List<EntityValue>();
        }

        return (fieldsByKey.Values.ToList(), fieldGroupsByKey.Values.ToList(), entityValuesMap);
    }

    private void EnsureEntityTypeReferences(IEnumerable<Entity> records)
    {
        if (records == null)
        {
            return;
        }

        foreach (var record in records)
        {
            EnsureEntityTypeReference(record);
        }
    }

    private void EnsureEntityTypeReference(Entity record)
    {
        if (record == null)
        {
            return;
        }

        if (_entityTypeLookup.TryGetValue(record.EntityTypeId, out var entityType))
        {
            record.EntityType = entityType;
        }
    }

    private string RenderTemplateSection(string templateContent)
    {
        if (string.IsNullOrEmpty(templateContent) || !_showListing)
        {
            return templateContent ?? string.Empty;
        }

        var typeName = _selectedEntityTypeName ?? string.Empty;
        return templateContent
            .Replace("[Type]", typeName, StringComparison.Ordinal)
            .Replace("[Type}", typeName, StringComparison.Ordinal);
    }

    private void BuildSortingOptions()
    {
        _sortingOptions = new List<(string Key, string Label)>
        {
            ("LastModified", "Last Modified"),
            ("PublishDate", "Publish Date")
        };

        var sortableFields = (_entityFields ?? new List<EntityField>())
            .Where(f => f.IsEnabled && f.IsSortable && !string.IsNullOrWhiteSpace(f.Key))
            .GroupBy(f => f.Key, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .OrderBy(f => f.Name)
            .ToList();

        foreach (var field in sortableFields)
        {
            var label = string.IsNullOrWhiteSpace(field.Name) ? field.Key : field.Name;
            _sortingOptions.Add((field.Key, label));
        }

        if (!_sortingOptions.Any(x => string.Equals(x.Key, _selectedSortFieldKey, StringComparison.OrdinalIgnoreCase)))
        {
            _selectedSortFieldKey = "LastModified";
        }
    }

    private void ApplyListingSort()
    {
        IEnumerable<Entity> query = _listingRecords ?? Enumerable.Empty<Entity>();
        var ascending = string.Equals(_selectedSortDirection, "Ascending", StringComparison.OrdinalIgnoreCase);

        if (string.Equals(_selectedSortFieldKey, "LastModified", StringComparison.OrdinalIgnoreCase))
        {
            query = ascending
                ? query.OrderBy(e => e.ModifiedOn).ThenBy(e => e.SortOrder)
                : query.OrderByDescending(e => e.ModifiedOn).ThenBy(e => e.SortOrder);
        }
        else if (string.Equals(_selectedSortFieldKey, "PublishDate", StringComparison.OrdinalIgnoreCase))
        {
            query = ascending
                ? query.OrderBy(e => e.PublishStartDate ?? DateTime.MinValue).ThenBy(e => e.SortOrder)
                : query.OrderByDescending(e => e.PublishStartDate ?? DateTime.MinValue).ThenBy(e => e.SortOrder);
        }
        else
        {
            query = SortByFieldValue(query, _selectedSortFieldKey, ascending);
        }

        _listingRecords = query.ToList();
    }

    private IEnumerable<Entity> SortByFieldValue(IEnumerable<Entity> source, string fieldKey, bool ascending)
    {
        if (string.IsNullOrWhiteSpace(fieldKey))
        {
            return source;
        }

        var field = (_entityFields ?? new List<EntityField>())
            .FirstOrDefault(f => string.Equals(f.Key, fieldKey, StringComparison.OrdinalIgnoreCase));

        if (field == null)
        {
            return source;
        }

        var valueSelector = new Func<Entity, IComparable>(entity =>
        {
            if (_listingEntityValuesMap.TryGetValue(entity.EntityId, out var values))
            {
                var match = (values ?? new List<EntityValue>())
                    .Where(v => v.FieldId == field.FieldId)
                    .OrderBy(v => v.ValueIndex)
                    .FirstOrDefault();

                return GetSortableValue(match, field.DataType);
            }

            return GetSortableValue(null, field.DataType);
        });

        return ascending
            ? source.OrderBy(valueSelector).ThenBy(entity => entity.SortOrder)
            : source.OrderByDescending(valueSelector).ThenBy(entity => entity.SortOrder);
    }

    private static IComparable GetSortableValue(EntityValue value, Enums.EntityDataType dataType)
    {
        return dataType switch
        {
            Enums.EntityDataType.Integer => value?.IntegerValue ?? int.MinValue,
            Enums.EntityDataType.Long => value?.LongValue ?? long.MinValue,
            Enums.EntityDataType.Decimal => value?.DecimalValue ?? decimal.MinValue,
            Enums.EntityDataType.Boolean => value?.BooleanValue ?? false,
            Enums.EntityDataType.Date => value?.DateValue ?? DateTime.MinValue,
            Enums.EntityDataType.DateTime => value?.DateTimeValue ?? DateTime.MinValue,
            Enums.EntityDataType.Guid => value?.GuidValue?.ToString() ?? string.Empty,
            _ => value?.TextValue ?? string.Empty
        };
    }

    private EntityTemplate ResolveTemplate(IEnumerable<EntityTemplate> templates, string templateType, int? entityTypeId)
    {
        var matchingTemplates = (templates ?? Enumerable.Empty<EntityTemplate>())
            .Where(t => string.Equals(t.TemplateType, templateType, StringComparison.OrdinalIgnoreCase))
            .OrderBy(t => t.TemplateId)
            .ToList();

        if (entityTypeId.HasValue)
        {
            var candidateTypeIds = _entityTypeLookup.Count > 0
                ? GetEffectiveEntityTypeIds(entityTypeId.Value, _entityTypeLookup)
                : new List<int> { entityTypeId.Value };

            foreach (var candidateTypeId in candidateTypeIds)
            {
                var typedTemplate = matchingTemplates.FirstOrDefault(t => t.EntityTypeId == candidateTypeId);
                if (typedTemplate != null)
                {
                    return typedTemplate;
                }
            }
        }

        return matchingTemplates.FirstOrDefault(t => !t.EntityTypeId.HasValue);
    }

    private static EntityTemplate ResolveDefaultTemplate(IEnumerable<EntityTemplate> templates)
    {
        return (templates ?? Enumerable.Empty<EntityTemplate>())
            .Where(t => !t.EntityTypeId.HasValue)
            .OrderBy(t => t.TemplateId)
            .FirstOrDefault();
    }

    private string GetQueryValue(string queryKey)
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (string.IsNullOrWhiteSpace(uri.Query) || string.IsNullOrWhiteSpace(queryKey))
        {
            return string.Empty;
        }

        foreach (var segment in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var keyValue = segment.Split('=', 2);
            if (keyValue.Length == 0)
            {
                continue;
            }

            var key = Uri.UnescapeDataString(keyValue[0]);
            if (string.Equals(key, queryKey, StringComparison.OrdinalIgnoreCase))
            {
                return keyValue.Length > 1 ? Uri.UnescapeDataString(keyValue[1]) : string.Empty;
            }
        }

        return string.Empty;
    }

    private string BuildCurrentPageUrl(string typeKey = null, string detailKey = null)
    {
        var baseUrl = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).GetLeftPart(UriPartial.Path);
        var queryParameters = new List<string>();

        if (!string.IsNullOrWhiteSpace(typeKey))
        {
            queryParameters.Add($"type={Uri.EscapeDataString(typeKey)}");
        }

        if (!string.IsNullOrWhiteSpace(detailKey))
        {
            queryParameters.Add($"detail={Uri.EscapeDataString(detailKey)}");
        }

        return queryParameters.Count > 0
            ? $"{baseUrl}?{string.Join("&", queryParameters)}"
            : baseUrl;
    }

    private string GetEditBaseUrl()
    {
        return NavigateUrl(ModuleState.ModuleId, "Edit");
    }

    private string GetEntityTypeUrl(string entityTypeKey)
    {
        return BuildCurrentPageUrl(typeKey: entityTypeKey);
    }

    private string GetEntityListUrl()
    {
        return BuildCurrentPageUrl();
    }

    private static List<int> GetEntityTypeAndDescendantIds(int entityTypeId, List<EntityType> allEntityTypes)
    {
        var result = new List<int>();
        if (entityTypeId <= 0)
        {
            return result;
        }

        var queue = new Queue<int>();
        var seen = new HashSet<int>();
        queue.Enqueue(entityTypeId);

        while (queue.Count > 0)
        {
            var currentId = queue.Dequeue();
            if (!seen.Add(currentId))
            {
                continue;
            }

            result.Add(currentId);

            foreach (var child in allEntityTypes.Where(t => t.ParentEntityTypeId == currentId))
            {
                queue.Enqueue(child.EntityTypeId);
            }
        }

        return result;
    }

    private static List<int> GetEffectiveEntityTypeIds(int entityTypeId, Dictionary<int, EntityType> lookup)
    {
        var result = new List<int>();
        var currentId = entityTypeId;
        var seen = new HashSet<int>();

        while (currentId > 0 && lookup.TryGetValue(currentId, out var entityType) && seen.Add(currentId))
        {
            result.Add(currentId);
            currentId = entityType.ParentEntityTypeId ?? 0;
        }

        return result;
    }

    private List<EntityType> BuildEntityTypeTree(List<EntityType> flatList)
    {
        foreach (var item in flatList)
        {
            item.Children = new List<EntityType>();
        }

        var lookup = flatList.ToDictionary(x => x.EntityTypeId);
        var roots = new List<EntityType>();

        foreach (var item in flatList.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
        {
            if (item.ParentEntityTypeId.HasValue && lookup.TryGetValue(item.ParentEntityTypeId.Value, out var parent))
            {
                parent.Children.Add(item);
            }
            else
            {
                roots.Add(item);
            }
        }

        return roots;
    }

    private RenderFragment RenderEntityTypeNavigation(IEnumerable<EntityType> entityTypes) => __builder =>
    {
        <ul class="list-unstyled ms-2">
            @foreach (var entityType in entityTypes.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
            {
                <li>
                    <a href="@GetEntityTypeUrl(entityType.Key)">@entityType.Name</a>
                    @if (entityType.Children != null && entityType.Children.Count > 0)
                    {
                        @RenderEntityTypeNavigation(entityType.Children)
                    }
                </li>
            }
        </ul>
    };
}