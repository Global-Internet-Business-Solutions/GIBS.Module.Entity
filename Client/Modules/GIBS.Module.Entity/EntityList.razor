@using System.Text.Json
@using GIBS.Module.Entity.Services
@using GIBS.Module.Entity.Models

@namespace GIBS.Module.Entity
@inherits ModuleBase
@inject IEntityService ClientEntityService
@inject IEntityFieldService EntityFieldService
@inject IEntityTypeService EntityTypeService
@inject IEntityValueService EntityValueService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<EntityList> Localizer

    <div class="row mb-4">
        <div class="col">
            <h2>@Localizer["BackOffice_Title"]</h2>
            <p class="text-muted">@Localizer["BackOffice_Description"]</p>
           <div class="d-flex justify-content-between">
               <NavLink class="btn btn-secondary" href="@NavigateUrl()">
                   <i class="oi oi-arrow-left"></i> @Localizer["Return"]
               </NavLink>
               <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Add Entity" Class="btn btn-success" ResourceKey="Add" />
           </div>
        </div>
    </div>

@if (_Entitys == null)
{
    <p><em>@Localizer["Loading"]</em></p>
}
else
{
    @if (@_Entitys.Count != 0)
    {
        <Pager Items="@_Entitys">
            <Header>
                <th style="width: 1px;">&nbsp;</th>
                <th style="width: 1px;">&nbsp;</th>
                <th>@Localizer["Name"]</th>
                <th>@Localizer["Type"]</th>
                @foreach (var field in _managerFields)
                {
                    <th>@GetFieldDisplayName(field)</th>
                }
                <th>@Localizer["Status"]</th>
                <th>@Localizer["IsEnabled"]</th>
                <th>@Localizer["SortOrder"]</th>
            </Header>
            <Row>
                <td><ActionLink Action="Edit" Parameters="@($"id={context.EntityId}")" IconName="oi oi-pencil" IconOnly="true" ResourceKey="Edit" /></td>
                <td><ActionDialog Header="Delete Entity" Message="Are You Sure You Wish To Delete This Entity?" IconName="oi oi-trash" IconOnly="true" Action="Delete" Security="SecurityAccessLevel.Edit" Class="btn btn-danger" OnClick="@(async () => await Delete(context))" ResourceKey="Delete" Id="@context.EntityId.ToString()" /></td>
                <td>@context.Name</td>
                <td>@context.EntityType?.Name</td>
               
                @foreach (var field in _managerFields)
                {
                    <td>@GetManagerFieldValue(context, field.FieldId)</td>
                }
                 <td>@context.Status</td>
                <td>@context.IsEnabled</td>
                <td>@context.SortOrder</td>
            </Row>
        </Pager>
    }
    else
    {
        <p>@Localizer["Message.DisplayNone"]</p>
    }
}

@code {
    public override string Actions => "EntityList";

    public override string RenderMode => RenderModes.Static;
    public override bool UseAdminContainer => false;

    public override List<Resource> Resources => new List<Resource>()
    {
        new Stylesheet("_content/GIBS.Module.Entity/Module.css"),
        new Script("_content/GIBS.Module.Entity/Module.js")
    };

    List<Entity> _Entitys;
    Dictionary<int, List<EntityField>> _managerFieldsByEntityType = new();
    List<EntityField> _managerFields = new();
    Dictionary<int, Dictionary<int, string>> _entityCustomValues = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Entity {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

    private async Task LoadDataAsync()
    {
        _Entitys = await ClientEntityService.GetEntitysAsync(ModuleState.ModuleId);

        var entityTypeIds = _Entitys
            .Select(e => e.EntityTypeId)
            .Where(id => id > 0)
            .Distinct()
            .ToList();

        var allEntityTypes = await EntityTypeService.GetEntityTypesAsync(PageState.Site.SiteId, ModuleState.ModuleId);
        var entityTypeLookup = (allEntityTypes ?? new List<EntityType>()).ToDictionary(x => x.EntityTypeId, x => x);

        _managerFieldsByEntityType = new Dictionary<int, List<EntityField>>();
        foreach (var entityTypeId in entityTypeIds)
        {
            var effectiveTypeIds = GetEffectiveEntityTypeIds(entityTypeId, entityTypeLookup);
            var fieldsById = new Dictionary<int, EntityField>();

            foreach (var effectiveTypeId in effectiveTypeIds)
            {
                var fields = await EntityFieldService.GetFieldsAsync(effectiveTypeId, ModuleState.ModuleId);
                foreach (var field in (fields ?? new List<EntityField>()).Where(f => f.IsManagerOnly))
                {
                    if (!fieldsById.ContainsKey(field.FieldId))
                    {
                        fieldsById[field.FieldId] = field;
                    }
                }
            }

            _managerFieldsByEntityType[entityTypeId] = fieldsById.Values
                .OrderBy(f => f.SortOrder)
                .ThenBy(f => f.Name)
                .ToList();
        }

        _managerFields = _managerFieldsByEntityType
            .SelectMany(x => x.Value)
            .GroupBy(f => f.FieldId)
            .Select(g => g.First())
            .OrderBy(f => f.SortOrder)
            .ThenBy(f => f.Name)
            .ToList();

        // Load custom field values from EntityValue table instead of Settings
        _entityCustomValues = new Dictionary<int, Dictionary<int, string>>();
        foreach (var entity in _Entitys)
        {
            var customValues = await LoadEntityCustomValuesAsync(entity.EntityId);
            _entityCustomValues[entity.EntityId] = customValues;
        }
    }

    private Dictionary<int, string> ParseCustomFieldValues(string settings)
    {
        if (string.IsNullOrWhiteSpace(settings))
        {
            return new Dictionary<int, string>();
        }

        try
        {
            return JsonSerializer.Deserialize<Dictionary<int, string>>(settings) ?? new Dictionary<int, string>();
        }
        catch
        {
            return new Dictionary<int, string>();
        }
    }

    /// <summary>
    /// Load custom field values from EntityValue table for a specific entity
    /// </summary>
    private async Task<Dictionary<int, string>> LoadEntityCustomValuesAsync(int entityId)
    {
        var customValues = new Dictionary<int, string>();

        try
        {
            var allValues = await EntityValueService.GetAllEntityValuesAsync(entityId);

            // Group values by FieldId and extract string value
            foreach (var fieldGroup in allValues.GroupBy(ev => ev.FieldId))
            {
                var fieldId = fieldGroup.Key;
                var values = fieldGroup.OrderBy(v => v.ValueIndex).ToList();

                if (values.Any())
                {
                    // Check if this is a multi-value field by seeing if there are multiple rows with same FieldId
                    if (values.Count > 1)
                    {
                        // For multi-value fields, combine all values into JSON array format
                        var multiValueItems = new List<string>();
                        foreach (var value in values)
                        {
                            if (!string.IsNullOrEmpty(value.TextValue))
                            {
                                multiValueItems.Add(value.TextValue);
                            }
                            else if (value.IntegerValue.HasValue)
                            {
                                multiValueItems.Add(value.IntegerValue.ToString());
                            }
                            else if (value.BooleanValue.HasValue)
                            {
                                multiValueItems.Add(value.BooleanValue.ToString());
                            }
                            else if (value.DateValue.HasValue)
                            {
                                multiValueItems.Add(value.DateValue.Value.ToString("yyyy-MM-dd"));
                            }
                            else if (value.DateTimeValue.HasValue)
                            {
                                multiValueItems.Add(value.DateTimeValue.Value.ToString("yyyy-MM-dd HH:mm"));
                            }
                            else if (value.DecimalValue.HasValue)
                            {
                                multiValueItems.Add(value.DecimalValue.ToString());
                            }
                            else if (value.GuidValue.HasValue)
                            {
                                multiValueItems.Add(value.GuidValue.ToString());
                            }
                            else if (value.ReferencedEntityId.HasValue)
                            {
                                multiValueItems.Add(value.ReferencedEntityId.ToString());
                            }
                        }
                        customValues[fieldId] = string.Join(", ", multiValueItems);
                    }
                    else
                    {
                        // For single-value fields, use the first (only) value
                        var firstValue = values.First();

                        if (firstValue.BooleanValue.HasValue)
                        {
                            customValues[fieldId] = firstValue.BooleanValue.ToString();
                        }
                        else if (!string.IsNullOrEmpty(firstValue.TextValue))
                        {
                            customValues[fieldId] = firstValue.TextValue;
                        }
                        else if (firstValue.DateValue.HasValue)
                        {
                            customValues[fieldId] = firstValue.DateValue.Value.ToString("yyyy-MM-dd");
                        }
                        else if (firstValue.DateTimeValue.HasValue)
                        {
                            customValues[fieldId] = firstValue.DateTimeValue.Value.ToString("yyyy-MM-dd HH:mm");
                        }
                        else if (firstValue.IntegerValue.HasValue)
                        {
                            customValues[fieldId] = firstValue.IntegerValue.ToString();
                        }
                        else if (firstValue.DecimalValue.HasValue)
                        {
                            customValues[fieldId] = firstValue.DecimalValue.ToString();
                        }
                        else if (firstValue.GuidValue.HasValue)
                        {
                            customValues[fieldId] = firstValue.GuidValue.ToString();
                        }
                        else if (firstValue.ReferencedEntityId.HasValue)
                        {
                            customValues[fieldId] = firstValue.ReferencedEntityId.ToString();
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            await logger.LogWarning(ex, "Unable to load EntityValue data for entity {EntityId}, falling back to settings. {Error}", entityId, ex.Message);
            // Fallback: Try to load from entity settings if EntityValue fails
            // Note: This requires loading the full entity object
        }

        return customValues;
    }

    private string GetFieldDisplayName(EntityField field)
    {
        return string.IsNullOrWhiteSpace(field.Label) ? field.Name : field.Label;
    }

    private string GetManagerFieldValue(Entity entity, int fieldId)
    {
        if (!_managerFieldsByEntityType.TryGetValue(entity.EntityTypeId, out var fields) || !fields.Any(f => f.FieldId == fieldId))
        {
            return string.Empty;
        }

        if (_entityCustomValues.TryGetValue(entity.EntityId, out var values) && values.TryGetValue(fieldId, out var value))
        {
            return value;
        }

        return string.Empty;
    }

    private static List<int> GetEffectiveEntityTypeIds(int entityTypeId, Dictionary<int, EntityType> lookup)
    {
        var result = new List<int>();
        var currentId = entityTypeId;
        var seen = new HashSet<int>();

        while (currentId > 0 && lookup.TryGetValue(currentId, out var entityType) && seen.Add(currentId))
        {
            result.Add(currentId);
            currentId = entityType.ParentEntityTypeId ?? 0;
        }

        return result;
    }

    private async Task Delete(Entity Entity)
    {
        try
        {
            await ClientEntityService.DeleteEntityAsync(Entity.EntityId, ModuleState.ModuleId);
            await logger.LogInformation("Entity Deleted {Entity}", Entity);
            await LoadDataAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Deleting Entity {Entity} {Error}", Entity, ex.Message);
            AddModuleMessage(Localizer["Message.DeleteError"], MessageType.Error);
        }
    }
}
