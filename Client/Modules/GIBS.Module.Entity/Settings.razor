@namespace GIBS.Module.Entity
@inherits ModuleBase
@implements Oqtane.Interfaces.ISettingsControl
@inject ISettingService SettingService
@inject IStringLocalizer<Settings> Localizer
@inject IFolderService FolderService

<div class="container">
    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="customtitle" HelpText="Custom title to display on the page" ResourceKey="CustomTitle" ResourceType="@resourceType">Custom Title: </Label>
        <div class="col-sm-9">
            <input id="customtitle" type="text" class="form-control" @bind="@_customTitle" maxlength="256" />
        </div>
    </div>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="enablefeatured" HelpText="Enable featured entity listing" ResourceKey="EnableFeatured" ResourceType="@resourceType">Enable Featured: </Label>
        <div class="col-sm-9">
            <input id="enablefeatured" type="checkbox" @bind="@_enableFeatured" />
        </div>
    </div>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="featurednumperpage" HelpText="Number of featured entities per page" ResourceKey="FeaturedNumPerPage" ResourceType="@resourceType">Featured Num Per Page: </Label>
        <div class="col-sm-9">
            <input id="featurednumperpage" type="number" class="form-control" @bind="@_featuredNumPerPage" min="1" />
        </div>
    </div>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="enabletypes" HelpText="Enable entity type listing" ResourceKey="EnableTypes" ResourceType="@resourceType">Enable Types: </Label>
        <div class="col-sm-9">
            <input id="enabletypes" type="checkbox" @bind="@_enableTypes" />
        </div>
    </div>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="listingnumperpage" HelpText="Number of entities per page in listings" ResourceKey="ListingNumPerPage" ResourceType="@resourceType">Listing Num Per Page: </Label>
        <div class="col-sm-9">
            <input id="listingnumperpage" type="number" class="form-control" @bind="@_listingNumPerPage" min="1" />
        </div>
    </div>
    <hr />
    <h5>Map Settings</h5>
    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="enablemap" HelpText="Enable map display for entity locations" ResourceKey="EnableMap" ResourceType="@resourceType">Enable Map: </Label>
        <div class="col-sm-9">
            <input id="enablemap" type="checkbox" class="form-check-input" @bind="@_enableMap" />
        </div>
    </div>


    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="zoomlevel" HelpText="Zoom level of the map" ResourceKey="ZoomLevel" ResourceType="@resourceType">Zoom Level: </Label>
        <div class="col-sm-9">
            <input id="zoomlevel" type="number" class="form-control" @bind="@_zoomLevel" min="1" max="20" />
        </div>
    </div>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="maptype" HelpText="Type of the map" ResourceKey="MapType" ResourceType="@resourceType">Map Type: </Label>
        <div class="col-sm-9">
            <select id="maptype" class="form-select" @bind="@_mapType">
                <option value="roadmap">Roadmap</option>
                <option value="satellite">Satellite</option>
                <option value="hybrid">Hybrid</option>
                <option value="terrain">Terrain</option>
            </select>
        </div>
    </div>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="googlemapsapikey" HelpText="Google Maps API key for map and address lookup" ResourceKey="GoogleMapsApiKey" ResourceType="@resourceType">Google Maps API Key: </Label>
        <div class="col-sm-9">
            <input id="googlemapsapikey" type="text" class="form-control" @bind="@_googleMapsApiKey" />
        </div>
    </div>

    <hr />
    <h5>Image Upload Settings</h5>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="filefolder" HelpText="Oqtane File Manager folder to save uploaded images" ResourceKey="FileFolderId" ResourceType="@resourceType">File Folder ID: </Label>
    <div class="col-sm-9">
        <select id="folderList" class="form-select" @bind="@_fileFolderId">
            @foreach (Folder folder in _folders)
            {
                <option value="@(folder.FolderId)">@(new string('-', folder.Level * 2))@(folder.Name)</option>
            }
        </select>
    </div>
    </div>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="imagethumbwidth" HelpText="Width of thumbnail images in pixels" ResourceKey="ImageThumbWidth" ResourceType="@resourceType">Thumbnail Width: </Label>
        <div class="col-sm-9">
            <input id="imagethumbwidth" type="number" class="form-control" @bind="@_imageThumbWidth" min="50" />
        </div>
    </div>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="imagethumbheight" HelpText="Height of thumbnail images in pixels" ResourceKey="ImageThumbHeight" ResourceType="@resourceType">Thumbnail Height: </Label>
        <div class="col-sm-9">
            <input id="imagethumbheight" type="number" class="form-control" @bind="@_imageThumbHeight" min="50" />
        </div>
    </div>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="imagemaxwidth" HelpText="Maximum width of full-size uploaded images in pixels" ResourceKey="ImageMaxWidth" ResourceType="@resourceType">Max Width: </Label>
        <div class="col-sm-9">
            <input id="imagemaxwidth" type="number" class="form-control" @bind="@_imageMaxWidth" min="100" />
        </div>
    </div>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="imagemaxheight" HelpText="Maximum height of full-size uploaded images in pixels" ResourceKey="ImageMaxHeight" ResourceType="@resourceType">Max Height: </Label>
        <div class="col-sm-9">
            <input id="imagemaxheight" type="number" class="form-control" @bind="@_imageMaxHeight" min="100" />
        </div>
    </div>

    <div class="row mb-1 align-items-center">
        <Label Class="col-sm-3" For="showphototitle" HelpText="Show the uploaded image file name as title" ResourceKey="ShowPhotoTitle" ResourceType="@resourceType">Show Image Title: </Label>
        <div class="col-sm-9">
            <input id="showphototitle" type="checkbox" @bind="@_showPhotoTitle" />
        </div>
    </div>
</div>

@code {
    private string resourceType = "GIBS.Module.Entity.Settings, GIBS.Module.Entity.Client.Oqtane"; // for localization
    public override string Title => "Entity Settings";

    private string _customTitle = string.Empty;
    private bool _enableFeatured;
    private int _featuredNumPerPage = 10;
    private bool _enableTypes;
    private int _listingNumPerPage = 20;

     private List<Folder> _folders = new List<Folder>();
    // Image Upload Settings
    private int _fileFolderId = 1;
    private int _imageThumbWidth = 360;
    private int _imageThumbHeight = 360;
    private int _imageMaxWidth = 1600;
    private int _imageMaxHeight = 900;
    private bool _showPhotoTitle = true;

    private bool _enableMap;
    private int _zoomLevel;
    private string _mapType = "roadmap";
    private string _googleMapsApiKey = string.Empty;





    protected override async Task OnInitializedAsync()
    {
        try
        {
            _folders = await FolderService.GetFoldersAsync(PageState.Site.SiteId);

            Dictionary<string, string> settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            _customTitle = SettingService.GetSetting(settings, "CustomTitle", string.Empty);
            _enableFeatured = bool.TryParse(SettingService.GetSetting(settings, "EnableFeatured", "true"), out var enableFeatured) && enableFeatured;
            _featuredNumPerPage = int.TryParse(SettingService.GetSetting(settings, "FeaturedNumPerPage", "10"), out var featuredNum) ? featuredNum : 10;
            _enableTypes = bool.TryParse(SettingService.GetSetting(settings, "EnableTypes", "true"), out var enableTypes) && enableTypes;
            _listingNumPerPage = int.TryParse(SettingService.GetSetting(settings, "ListingNumPerPage", "20"), out var listingNum) ? listingNum : 20;

            _enableMap = bool.TryParse(SettingService.GetSetting(settings, "EnableMap", "false"), out var enableMap) && enableMap;
            _zoomLevel = int.TryParse(SettingService.GetSetting(settings, "ZoomLevel", "10"), out var zoomLevel) ? zoomLevel : 10;
            _mapType = SettingService.GetSetting(settings, "MapType", "roadmap");
            _googleMapsApiKey = SettingService.GetSetting(settings, "GoogleMapsApiKey", string.Empty);

            // Load Image Upload Settings
            _fileFolderId = int.TryParse(SettingService.GetSetting(settings, "FileFolderId", "1"), out var fileFolderId) ? fileFolderId : 1;
            _imageThumbWidth = int.TryParse(SettingService.GetSetting(settings, "ImageThumbWidth", "360"), out var thumbWidth) ? thumbWidth : 360;
            _imageThumbHeight = int.TryParse(SettingService.GetSetting(settings, "ImageThumbHeight", "360"), out var thumbHeight) ? thumbHeight : 360;
            _imageMaxWidth = int.TryParse(SettingService.GetSetting(settings, "ImageMaxWidth", "1600"), out var maxWidth) ? maxWidth : 1600;
            _imageMaxHeight = int.TryParse(SettingService.GetSetting(settings, "ImageMaxHeight", "900"), out var maxHeight) ? maxHeight : 900;
            _showPhotoTitle = bool.TryParse(SettingService.GetSetting(settings, "ShowPhotoTitle", "true"), out var showTitle) && showTitle;
        }
        catch (Exception ex)
        {
            AddModuleMessage(ex.Message, MessageType.Error);
        }
    }

    public async Task UpdateSettings()
    {
        try
        {
            var settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            settings = SettingService.SetSetting(settings, "CustomTitle", _customTitle ?? string.Empty);
            settings = SettingService.SetSetting(settings, "EnableFeatured", _enableFeatured.ToString());
            settings = SettingService.SetSetting(settings, "FeaturedNumPerPage", _featuredNumPerPage.ToString());
            settings = SettingService.SetSetting(settings, "EnableTypes", _enableTypes.ToString());
            settings = SettingService.SetSetting(settings, "ListingNumPerPage", _listingNumPerPage.ToString());

            settings = SettingService.SetSetting(settings, "EnableMap", _enableMap.ToString());
            settings = SettingService.SetSetting(settings, "ZoomLevel", _zoomLevel.ToString());
            settings = SettingService.SetSetting(settings, "MapType", string.IsNullOrWhiteSpace(_mapType) ? "roadmap" : _mapType);
            settings = SettingService.SetSetting(settings, "GoogleMapsApiKey", _googleMapsApiKey ?? string.Empty);

            // Save Image Upload Settings
            settings = SettingService.SetSetting(settings, "FileFolderId", _fileFolderId.ToString());
            settings = SettingService.SetSetting(settings, "ImageThumbWidth", _imageThumbWidth.ToString());
            settings = SettingService.SetSetting(settings, "ImageThumbHeight", _imageThumbHeight.ToString());
            settings = SettingService.SetSetting(settings, "ImageMaxWidth", _imageMaxWidth.ToString());
            settings = SettingService.SetSetting(settings, "ImageMaxHeight", _imageMaxHeight.ToString());
            settings = SettingService.SetSetting(settings, "ShowPhotoTitle", _showPhotoTitle.ToString());

            await SettingService.UpdateModuleSettingsAsync(settings, ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            AddModuleMessage(ex.Message, MessageType.Error);
        }
    }
}
