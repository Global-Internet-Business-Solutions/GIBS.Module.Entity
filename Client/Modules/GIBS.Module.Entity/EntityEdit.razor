@using System.Text.Json
@using Oqtane.Modules.Controls
@using GIBS.Module.Entity.Services
@using GIBS.Module.Entity.Models
@using GIBS.Module.Entity.Enums
@using GIBS.Module.Entity.Interfaces
@using Oqtane.Modules.HtmlText.Services

@namespace GIBS.Module.Entity
@inherits ModuleBase
@inject IEntityService ClientEntityService
@inject IEntityTypeService EntityTypeService
@inject IEntityFieldService EntityFieldService
@inject IEntityFieldOptionService EntityFieldOptionService
@inject IEntityValueService EntityValueService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<EntityEdit> Localizer
@inject ISettingService SettingService
@inject IFileService FileService
@inject IHtmlTextService HtmlTextService

<form @ref="form" class="@(validated ? "was-validated" : "needs-validation")" novalidate>
    <div class="container">
        <h4>@_mode @Localizer["Record"]</h4>

        <!-- Entity Type Selection -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="entitytypeid" HelpText="Select the entity type" ResourceKey="EntityType">Entity Type: </Label>
            <div class="col-sm-9">
                <select id="entitytypeid" class="form-select" @bind="@_entityTypeId" @bind:after="OnEntityTypeChanged" required>
                    <option value="0">-- @Localizer["SelectOne"] --</option>
                    @RenderEntityTypeOptions(_entityTypeTree, 0)
                </select>
            </div>
        </div>

        <!-- Name -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="name" HelpText="Enter a name" ResourceKey="Name">Name: </Label>
            <div class="col-sm-9">
                <input id="name" class="form-control" @bind="@_name" maxlength="256" required />
            </div>
        </div>

        <!-- Key -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="key" HelpText="Unique stable key for this entity" ResourceKey="Key">Key: </Label>
            <div class="col-sm-9">
                <input id="key" class="form-control" @bind="@_key" maxlength="100" />
            </div>
        </div>

        <!-- Description -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="description" HelpText="Description of the entity" ResourceKey="Description">Description: </Label>
            <div class="col-sm-9">
                <textarea id="description" class="form-control" @bind="@_description" rows="3" maxlength="500"></textarea>
            </div>
        </div>

        <!-- Parent Entity -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="parententityid" HelpText="Optional parent entity for hierarchy" ResourceKey="ParentEntity">Parent Entity: </Label>
            <div class="col-sm-9">
                <select id="parententityid" class="form-select" @bind="@_parentEntityId">
                    <option value="">@Localizer["None"]</option>
                    @foreach (var entity in _availableParentEntities)
                    {
                        <option value="@entity.EntityId">@entity.Name</option>
                    }
                </select>
            </div>
        </div>
        <!-- Custom Fields -->
        @if (_customFields.Any())
        {
            <hr />
         
            @foreach (var customField in _customFields)
            {
                // Ensure dictionary keys exist before rendering
                if (!_customFieldValues.ContainsKey(customField.FieldId))
                {
                    _customFieldValues[customField.FieldId] = string.Empty;
                }
                if (!_customFieldBoolValues.ContainsKey(customField.FieldId))
                {
                    _customFieldBoolValues[customField.FieldId] = false;
                }
                <div class="row mb-1 align-items-start" @key="customField.FieldId">
                    @if (!customField.IsCaptionHidden)
                    {
                        <Label Class="col-sm-3" For="@($"cf_{customField.FieldId}")" HelpText="@customField.HelpText" ResourceKey="@customField.Key">@(string.IsNullOrWhiteSpace(customField.Label) ? customField.Name : customField.Label): </Label>
                    }
                    <div class="@(customField.IsCaptionHidden ? "col-sm-12" : "col-sm-9")">
                        @if (customField.EditorType == EntityEditorType.HtmlContentDisplay)
                        {
                            @((MarkupString)(customField.HtmlContent ?? string.Empty)) 
                        }
                        else if (customField.EditorType == EntityEditorType.HtmlEditor)
                        {
                            var fieldId = customField.FieldId;
                            var htmlContent = GetCustomFieldValue(fieldId, customField.DefaultValue);
                            if (!_htmlEditors.ContainsKey(fieldId))
                            {
                                _htmlEditors[fieldId] = null;
                            }
                            <RichTextEditor @key="@($"rte_{fieldId}_{_htmlEditorRenderVersion}")" @ref="@_htmlEditors[fieldId]" Content="@htmlContent" />
                        }
                        else if (customField.EditorType == EntityEditorType.TextArea || customField.EditorType == EntityEditorType.RichText)
                        {
                            <textarea id="@($"cf_{customField.FieldId}")" class="form-control" @bind="@_customFieldValues[customField.FieldId]"></textarea>
                        }
                        else if (customField.EditorType == EntityEditorType.Dropdown)
                        { 
                            var options = GetFieldOptions(customField.FieldId);
                            <select id="@($"cf_{customField.FieldId}")" class="form-select" @bind="@_customFieldValues[customField.FieldId]">
                                <option value="">@Localizer["SelectOne"]</option>
                                @foreach (var option in options)
                                {
                                    <option value="@option.Value">@option.DisplayText</option>
                                }
                            </select>
                        }
                        else if (customField.EditorType == EntityEditorType.MultiSelect || customField.EditorType == EntityEditorType.CheckboxList)
                        {
                            var options = GetFieldOptions(customField.FieldId);
                            <div class="mt-2">
                                @foreach (var option in options)
                                {
                                    var checkboxId = $"cf_{customField.FieldId}_{option.FieldOptionId}";
                                    <div class="form-check">
                                        <input id="@checkboxId" type="checkbox" class="form-check-input"
                                               checked="@IsMultiSelectOptionSelected(customField.FieldId, option.Value)"
                                               @onchange="(e => ToggleMultiSelectOption(customField.FieldId, option.Value, e.Value))" />
                                        <label class="form-check-label" for="@checkboxId">@option.DisplayText</label>
                                    </div>
                                }
                            </div>
                        }
                        else if (customField.EditorType == EntityEditorType.Checkbox || customField.EditorType == EntityEditorType.Toggle)
                        {
                            <div class="form-check mt-2">
                                <input id="@($"cf_{customField.FieldId}")" type="checkbox" class="form-check-input" @bind="@_customFieldBoolValues[customField.FieldId]" />
                            </div>
                        }
                        else if (customField.EditorType == EntityEditorType.DatePicker)
                        {
                            <input id="@($"cf_{customField.FieldId}")" type="date" class="form-control" value="@GetCustomFieldValue(customField.FieldId, customField.DefaultValue)" @onchange="@(e => _customFieldValues[customField.FieldId] = e.Value?.ToString() ?? string.Empty)" />
                        }
                        else if (customField.EditorType == EntityEditorType.DateTimePicker)
                        {
                            <input id="@($"cf_{customField.FieldId}")" type="datetime-local" class="form-control" value="@GetCustomFieldValue(customField.FieldId, customField.DefaultValue)" @onchange="@(e => _customFieldValues[customField.FieldId] = e.Value?.ToString() ?? string.Empty)" />
                        }
                        else if (customField.EditorType == EntityEditorType.Number || customField.EditorType == EntityEditorType.Currency)
                        {
                            <input id="@($"cf_{customField.FieldId}")" type="number" class="form-control" @bind="@_customFieldValues[customField.FieldId]" />
                        }
                        else if (customField.EditorType == EntityEditorType.FileUpload)
                        {
                            <div>
                                <div class="form-group mb-2">
                                    <label>@customField.Label</label>

                                    @if (_currentImageFieldId == 0 || _currentImageFieldId == customField.FieldId)
                                    {
                                        <FileManager UploadMultiple="false"
                                                     FolderId="@_fileFolderId"
                                                     ShowSuccess="false" ShowFolders="false" ShowFiles="false" ShowImage="false" ShowUpload="true"
                                                     OnUpload="@(async (fileId) => await HandleFileUploadAsync(fileId, customField.FieldId))" />
                                    }

                                    @{
                                        var filePaths = GetAllImagePathsFromField(customField.FieldId);
                                    }

                                    @if (filePaths.Count > 0)
                                    {
                                        <ul class="list-unstyled mb-0 mt-2">
                                            @foreach (var filePath in filePaths)
                                            {
                                                <li><a href="@filePath" target="_blank">@filePath</a></li>
                                            }
                                        </ul>
                                    }
                                </div>
                            </div>
                        }
                        else if (customField.EditorType == EntityEditorType.ImageUpload)
                        {
                            <div>
                                <div class="form-group mb-2">
                                    <label>@customField.Label</label>

                                    <!-- File Manager Component -->
                                    @if (_currentImageFieldId == 0 || _currentImageFieldId == customField.FieldId)
                                    {
                                        <FileManager UploadMultiple="false" Filter="jpg,png,gif,jpeg"
                                                     FolderId="@_fileFolderId"
                                                     ShowSuccess="false" ShowFolders="false" ShowFiles="false" ShowImage="false" ShowUpload="true"
                                                     OnUpload="@(async (fileId) => await HandleFileUploadAsync(fileId, customField.FieldId))" />
                                    }

                                    <!-- Image Preview - Single or Multiple -->
                                    @{
                                        var field = _customFields.FirstOrDefault(f => f.FieldId == customField.FieldId);
                                        var imagePaths = GetAllImagePathsFromField(customField.FieldId);
                                    }

                                    @if (imagePaths.Count > 0)
                                    {
                                        <div class="mb-2 mt-2">
                                            @for (int imageIndex = 0; imageIndex < imagePaths.Count; imageIndex++)
                                            {
                                                var imagePath = imagePaths[imageIndex];
                                                var currentIndex = imageIndex;
                                                <div class="mb-3 position-relative" style="display: inline-block; margin-right: 10px;">
                                                    <img src="@imagePath" alt="Image preview" style="max-width: 150px; max-height: 150px; border-radius: 4px;" />
                                                    @if (field?.IsMultiValue == true)
                                                    {
                                                        <!-- Delete button -->
                                                        <button type="button" class="btn btn-sm btn-danger" style="position: absolute; top: 5px; right: 5px;" 
                                                                @onclick="() => RemoveImageFromField(customField.FieldId, imagePath)"
                                                                title="Delete image">
                                                            ✕
                                                        </button>

                                                        <!-- Move up button -->
                                                        @if (currentIndex > 0)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-secondary" style="position: absolute; bottom: 5px; left: 5px;" 
                                                                    @onclick="() => MoveImageUp(customField.FieldId, currentIndex)"
                                                                    title="Move up">
                                                                ▲
                                                            </button>
                                                        }

                                                        <!-- Move down button -->
                                                        @if (currentIndex < imagePaths.Count - 1)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-secondary" style="position: absolute; bottom: 5px; left: 30px;" 
                                                                    @onclick="() => MoveImageDown(customField.FieldId, currentIndex)"
                                                                    title="Move down">
                                                                ▼
                                                            </button>
                                                        }
                                                    }
                                                </div>
                                            }
                                            @if (field?.IsMultiValue != true && imagePaths.Count > 0)
                                            {
                                                <div class="mt-2">
                                                    <small class="text-muted">@imagePaths[0]</small>
                                                    <br />
                                                    <button type="button" class="btn btn-sm btn-danger mt-2" @onclick="() => ClearImage(customField.FieldId)">
                                                        Remove Image
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <input id="@($"cf_{customField.FieldId}")" class="form-control" @bind="@_customFieldValues[customField.FieldId]" maxlength="@(customField.MaxLength ?? 2000)" />
                        }
                    </div>
                </div>
            }
            <hr />
        }

        <!-- Status -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="status" HelpText="Current status of the entity" ResourceKey="Status">Status: </Label>
            <div class="col-sm-9">
                <select id="status" class="form-select" @bind="@_status">
                    @foreach (var status in StatusOptions)
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
        </div>

        <!-- Sort Order -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="sortorder" HelpText="Display order" ResourceKey="SortOrder">Sort Order: </Label>
            <div class="col-sm-9">
                <input id="sortorder" type="number" class="form-control" @bind="@_sortOrder" />
            </div>
        </div>

        <!-- Is Enabled -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="isenabled" HelpText="Is this entity enabled?" ResourceKey="Enabled">Enabled? </Label>
            <div class="col-sm-9">
                <select id="isenabled" class="form-select" @bind="@_isEnabled">
                    <option value="True">@Localizer["Yes"]</option>
                    <option value="False">@Localizer["No"]</option>
                </select>
            </div>
        </div>

        <!-- Is Featured -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="isfeatured" HelpText="Is this entity featured?" ResourceKey="Featured">Featured? </Label>
            <div class="col-sm-9">
                <select id="isfeatured" class="form-select" @bind="@_isFeatured">
                    <option value="True">@Localizer["Yes"]</option>
                    <option value="False">@Localizer["No"]</option>
                </select>
            </div>
        </div>

        <!-- Is Published -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="ispublished" HelpText="Is this entity published?" ResourceKey="Published">Published? </Label>
            <div class="col-sm-9">
                <select id="ispublished" class="form-select" @bind="@_isPublished">
                    <option value="True">@Localizer["Yes"]</option>
                    <option value="False">@Localizer["No"]</option>
                </select>
            </div>
        </div>

        <!-- Publish Start Date -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="publishstartdate" HelpText="When to start publishing" ResourceKey="PublishStartDate">Publish Start Date: </Label>
            <div class="col-sm-9">
                <input id="publishstartdate" type="datetime-local" class="form-control" @bind="@_publishStartDate" />
            </div>
        </div>

        <!-- Publish End Date -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="publishenddate" HelpText="When to stop publishing" ResourceKey="PublishEndDate">Publish End Date: </Label>
            <div class="col-sm-9">
                <input id="publishenddate" type="datetime-local" class="form-control" @bind="@_publishEndDate" />
            </div>
        </div>

        <!-- Settings (JSON) -->
        <div class="row mb-1 align-items-center">
            <Label Class="col-sm-3" For="settings" HelpText="Additional settings in JSON format" ResourceKey="Settings">Settings: </Label>
            <div class="col-sm-9">
                <textarea id="settings" class="form-control" @bind="@_settings" rows="4"></textarea>
            </div>
        </div>
    </div>
    <button type="button" class="btn btn-success" @onclick="Save">@Localizer["Save"]</button>
    <NavLink class="btn btn-secondary" href="@NavigateUrl()">@Localizer["Cancel"]</NavLink>
    <br /><br />
    @if (PageState.Action == "Edit")
    {
        <AuditInfo CreatedBy="@_createdby" CreatedOn="@_createdon" ModifiedBy="@_modifiedby" ModifiedOn="@_modifiedon"></AuditInfo>
    }
</form>

@code {
    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.Edit;
    public override string RenderMode => RenderModes.Interactive;
     public override bool UseAdminContainer => false;

    public override string Actions => "Add,Edit";

    public override string Title => "Manage Entity";

    public override List<Resource> Resources => new List<Resource>()
    {
        new Stylesheet("_content/GIBS.Module.Entity/Module.css")
    };

