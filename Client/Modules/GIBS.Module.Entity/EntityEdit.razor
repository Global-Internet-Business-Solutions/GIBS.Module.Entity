    /// <summary>
    /// Handle file upload from Oqtane FileManager component
    /// FileManager.OnUpload passes only the FileId (int), not the entire file object.
    /// We must use IFileService.GetFileAsync(fileId) to retrieve full file details.
    /// Stores both FileId (for referential integrity) and FilePath (for fast rendering + fallback)
    /// For single-value fields: {"fileId": 123, "filePath": "/path/to/image.jpg"}
    /// For multi-value fields: [{"fileId": 123, ...}, {"fileId": 124, ...}]
    /// Based on: https://github.com/JoeAucoin/GIBS.Module.PhotoGallery/blob/8ae2d64a6ba7a6e91ade00ba4b4a909a8be5efaf/Client/Modules/GIBS.Module.PhotoGallery/ManageGallery.razor
    /// </summary>
    private async Task HandleFileUploadAsync(int fileId, int fieldId)
    {
        try
        {
            await logger.LogInformation($"=== HandleFileUploadAsync START ===");
            await logger.LogInformation($"FileId: {fileId}, FieldId: {fieldId}");

            // Get full file details from IFileService
            var uploadedFile = await FileService.GetFileAsync(fileId);

            if (uploadedFile == null)
            {
                await logger.LogError($"✗ FileService.GetFileAsync({fileId}) returned null!");
                AddModuleMessage($"Could not retrieve file details for FileId {fileId}", MessageType.Error);
                await logger.LogInformation($"=== HandleFileUploadAsync END (FILE NOT FOUND) ===");
                return;
            }

            await logger.LogInformation($"✓ File retrieved: Id={uploadedFile.FileId}, Name={uploadedFile.Name}, Url={uploadedFile.Url}");

            // Ensure field is initialized in dictionary
            if (!_customFieldValues.ContainsKey(fieldId))
            {
                _customFieldValues[fieldId] = string.Empty;
                await logger.LogDebug($"Initialized _customFieldValues[{fieldId}]");
            }

            // Find the field to check if it's multi-value
            var field = _customFields.FirstOrDefault(f => f.FieldId == fieldId);
            bool isMultiValue = field?.IsMultiValue ?? false;

            await logger.LogInformation($"Field info: IsMultiValue={isMultiValue}");

            // Extract FileId and FilePath
            int resizedFileId = uploadedFile.FileId;
            string filePath = uploadedFile.Url;

            await logger.LogInformation($"Extracted values - FileId: {resizedFileId}, FilePath: {filePath}");

            // Create image data object with both FileId and FilePath
            var imageData = new { fileId = resizedFileId, filePath };
            string jsonValue = JsonSerializer.Serialize(imageData);
            await logger.LogInformation($"JSON serialized: {jsonValue}");

            if (isMultiValue)
            {
                // For multi-value fields, append to existing array
                string currentValue = _customFieldValues[fieldId];
                List<object> images;

                if (string.IsNullOrWhiteSpace(currentValue))
                {
                    // Start new array
                    images = new List<object> { imageData };
                    await logger.LogInformation($"✓ Started new multi-value array");
                }
                else if (currentValue.StartsWith("[") && currentValue.EndsWith("]"))
                {
                    // Parse existing array and add new image
                    images = JsonSerializer.Deserialize<List<object>>(currentValue) ?? new List<object>();
                    images.Add(imageData);
                    await logger.LogInformation($"✓ Appended to existing array, now {images.Count} images");
                }
                else
                {
                    // Handle legacy object or concatenated objects, then append new image
                    images = new List<object>();

                    var correctedValue = currentValue.Replace("}, {", "},{");
                    if (correctedValue.StartsWith("{") && correctedValue.Contains("},{", StringComparison.Ordinal))
                    {
                        correctedValue = "[" + correctedValue + "]";
                    }

                    try
                    {
                        if (correctedValue.StartsWith("[") && correctedValue.EndsWith("]"))
                        {
                            images = JsonSerializer.Deserialize<List<object>>(correctedValue) ?? new List<object>();
                        }
                        else
                        {
                            var single = JsonSerializer.Deserialize<object>(correctedValue);
                            if (single != null)
                            {
                                images.Add(single);
                            }
                        }
                    }
                    catch
                    {
                        // If legacy payload cannot be parsed, start fresh and keep new upload
                        images = new List<object>();
                    }

                    images.Add(imageData);
                    await logger.LogInformation($"✓ Converted legacy/single to array, now {images.Count} images");
                }

                _customFieldValues[fieldId] = JsonSerializer.Serialize(images);
                await logger.LogInformation($"✓ Multi-value image stored: _customFieldValues[{fieldId}]");
            }
            else
            {
                // For single-value fields, replace the value
                _customFieldValues[fieldId] = jsonValue;
                await logger.LogInformation($"✓ Single-value image stored: _customFieldValues[{fieldId}]");
            }

            // Verify the value was saved
            var verifyValue = _customFieldValues[fieldId];
            await logger.LogInformation($"✓ VERIFICATION - Value now in dict: '{verifyValue}'");

            // Reset current field ID after upload
            _currentImageFieldId = 0;

            // Force UI update
            StateHasChanged();
            await logger.LogInformation($"✓ StateHasChanged() called");
            await logger.LogInformation($"=== HandleFileUploadAsync END (SUCCESS) ===");

            AddModuleMessage("File uploaded successfully.", MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "✗ EXCEPTION in HandleFileUploadAsync: {Error}", ex.Message);
            await logger.LogInformation($"=== HandleFileUploadAsync END (EXCEPTION) ===");
            AddModuleMessage($"Error uploading file: {ex.Message}", MessageType.Error);
        }
    }

