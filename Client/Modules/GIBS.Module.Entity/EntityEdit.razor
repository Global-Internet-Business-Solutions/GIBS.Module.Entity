    /// <summary>
    /// Remove a specific image from a multi-value ImageUpload field
    /// </summary>
    private async Task RemoveImageFromField(int fieldId, string imagePath)
    {
        try
        {
            var value = GetCustomFieldValue(fieldId, "");

            if (string.IsNullOrEmpty(value))
                return;

            List<Dictionary<string, object>> imageArray = null;
            bool isLegacyFormat = false;

            if (value.StartsWith("[") && value.EndsWith("]"))
            {
                // Multi-value array format
                imageArray = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(value) ?? new List<Dictionary<string, object>>();
            }
            else if (value.StartsWith("{"))
            {
                // Legacy format: {"fileId":12,"filePath":"..."}, {"fileId":10,"filePath":"..."}
                // Try to convert to array
                isLegacyFormat = true;
                var correctedValue = value.Replace("}, {", "},{");
                if (!correctedValue.StartsWith("["))
                    correctedValue = "[" + correctedValue + "]";

                try
                {
                    imageArray = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(correctedValue) ?? new List<Dictionary<string, object>>();
                }
                catch
                {
                    // Single object format
                    var imageData = JsonSerializer.Deserialize<Dictionary<string, object>>(value);
                    if (imageData != null && imageData.TryGetValue("filePath", out var path) && path?.ToString() == imagePath)
                    {
                        _customFieldValues[fieldId] = string.Empty;
                        StateHasChanged();
                        await logger.LogInformation($"Removed single image from field {fieldId}");
                    }
                    return;
                }
            }

            if (imageArray != null)
            {
                // Remove image with matching path
                var toRemove = imageArray.FirstOrDefault(img => 
                    img.TryGetValue("filePath", out var path) && path?.ToString() == imagePath);

                if (toRemove != null)
                {
                    imageArray.Remove(toRemove);

                    if (imageArray.Count > 0)
                    {
                        // If it was legacy format, keep it as array going forward
                        _customFieldValues[fieldId] = JsonSerializer.Serialize(imageArray);
                        await logger.LogInformation($"Removed image {imagePath} from field {fieldId}. Remaining: {imageArray.Count}");
                    }
                    else
                    {
                        _customFieldValues[fieldId] = string.Empty;
                        await logger.LogInformation($"Removed last image from field {fieldId}");
                    }

                    StateHasChanged();
                }
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error removing image from field {FieldId}: {Error}", fieldId, ex.Message);
        }
    }

    private async Task MoveImageUp(int fieldId, int imageIndex)
    {
        if (imageIndex <= 0)
            return;

        try
        {
            await logger.LogInformation($"=== MoveImageUp START - FieldId: {fieldId}, Index: {imageIndex}");
            var value = GetCustomFieldValue(fieldId, "");
            if (string.IsNullOrEmpty(value))
            {
                await logger.LogWarning($"No value found for field {fieldId}");
                return;
            }

            await logger.LogInformation($"Current value before move: {value.Substring(0, Math.Min(100, value.Length))}...");

            List<Dictionary<string, object>> imageArray = null;

            if (value.StartsWith("[") && value.EndsWith("]"))
            {
                imageArray = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(value) ?? new List<Dictionary<string, object>>();
            }
            else if (value.StartsWith("{"))
            {
                // Legacy format - convert to array
                var correctedValue = value.Replace("}, {", "},{");
                if (!correctedValue.StartsWith("["))
                    correctedValue = "[" + correctedValue + "]";
                imageArray = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(correctedValue) ?? new List<Dictionary<string, object>>();
            }

            if (imageArray != null && imageIndex > 0 && imageIndex < imageArray.Count)
            {
                // Swap with previous
                var temp = imageArray[imageIndex];
                imageArray[imageIndex] = imageArray[imageIndex - 1];
                imageArray[imageIndex - 1] = temp;

                var newValue = JsonSerializer.Serialize(imageArray);
                _customFieldValues[fieldId] = newValue;
                await logger.LogInformation($"Moved image up at index {imageIndex} in field {fieldId}");
                await logger.LogInformation($"New value: {newValue.Substring(0, Math.Min(100, newValue.Length))}...");
                StateHasChanged();
                await logger.LogInformation($"=== MoveImageUp END (SUCCESS)");
            }
            else
            {
                await logger.LogWarning($"Cannot move up - imageArray is null or index out of range. ImageArray count: {imageArray?.Count}, Index: {imageIndex}");
                await logger.LogInformation($"=== MoveImageUp END (INDEX OUT OF RANGE)");
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error moving image up in field {FieldId}: {Error}", fieldId, ex.Message);
            await logger.LogInformation($"=== MoveImageUp END (EXCEPTION)");
        }
    }

    private async Task MoveImageDown(int fieldId, int imageIndex)
    {
        try
        {
            await logger.LogInformation($"=== MoveImageDown START - FieldId: {fieldId}, Index: {imageIndex}");
            var value = GetCustomFieldValue(fieldId, "");
            if (string.IsNullOrEmpty(value))
            {
                await logger.LogWarning($"No value found for field {fieldId}");
                return;
            }

            await logger.LogInformation($"Current value before move: {value.Substring(0, Math.Min(100, value.Length))}...");

            List<Dictionary<string, object>> imageArray = null;

            if (value.StartsWith("[") && value.EndsWith("]"))
            {
                imageArray = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(value) ?? new List<Dictionary<string, object>>();
            }
            else if (value.StartsWith("{"))
            {
                // Legacy format - convert to array
                var correctedValue = value.Replace("}, {", "},{");
                if (!correctedValue.StartsWith("["))
                    correctedValue = "[" + correctedValue + "]";
                imageArray = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(correctedValue) ?? new List<Dictionary<string, object>>();
            }

            if (imageArray != null && imageIndex >= 0 && imageIndex < imageArray.Count - 1)
            {
                // Swap with next
                var temp = imageArray[imageIndex];
                imageArray[imageIndex] = imageArray[imageIndex + 1];
                imageArray[imageIndex + 1] = temp;

                var newValue = JsonSerializer.Serialize(imageArray);
                _customFieldValues[fieldId] = newValue;
                await logger.LogInformation($"Moved image down at index {imageIndex} in field {fieldId}");
                await logger.LogInformation($"New value: {newValue.Substring(0, Math.Min(100, newValue.Length))}...");
                StateHasChanged();
                await logger.LogInformation($"=== MoveImageDown END (SUCCESS)");
            }
            else
            {
                await logger.LogWarning($"Cannot move down - imageArray is null or index out of range. ImageArray count: {imageArray?.Count}, Index: {imageIndex}");
                await logger.LogInformation($"=== MoveImageDown END (INDEX OUT OF RANGE)");
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error moving image down in field {FieldId}: {Error}", fieldId, ex.Message);
            await logger.LogInformation($"=== MoveImageDown END (EXCEPTION)");
        }
    }

    private bool GetCustomFieldBoolValue(int fieldId, string defaultValue = null)
    {
        var value = GetCustomFieldValue(fieldId, defaultValue);
        return bool.TryParse(value, out var boolValue) && boolValue;
    }

    private void SetCustomFieldValue(int fieldId, string value)
    {
        _customFieldValues[fieldId] = value ?? string.Empty;
    }

    private bool IsMultiSelectOptionSelected(int fieldId, string optionValue)
    {
        if (!_customFieldValues.TryGetValue(fieldId, out var current) || string.IsNullOrWhiteSpace(current) || string.IsNullOrWhiteSpace(optionValue))
        {
            return false;
        }

        return current.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(v => v.Trim())
            .Any(v => string.Equals(v, optionValue, StringComparison.OrdinalIgnoreCase));
    }

    private void ToggleMultiSelectOption(int fieldId, string optionValue, object isChecked)
    {
        if (string.IsNullOrWhiteSpace(optionValue))
        {
            return;
        }

        var selectedValues = _customFieldValues.TryGetValue(fieldId, out var current) && !string.IsNullOrWhiteSpace(current)
            ? current.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(v => v.Trim()).Where(v => !string.IsNullOrWhiteSpace(v)).ToList()
            : new List<string>();

        var shouldSelect = isChecked is bool checkedValue && checkedValue;

        if (shouldSelect)
        {
            if (!selectedValues.Any(v => string.Equals(v, optionValue, StringComparison.OrdinalIgnoreCase)))
            {
                selectedValues.Add(optionValue);
            }
        }
        else
        {
            selectedValues = selectedValues.Where(v => !string.Equals(v, optionValue, StringComparison.OrdinalIgnoreCase)).ToList();
        }

        _customFieldValues[fieldId] = string.Join(",", selectedValues);
    }

    private async Task SyncHtmlEditorValuesAsync()
    {
        await logger.LogInformation($"SyncHtmlEditorValuesAsync START - {_htmlEditors.Count} editors to sync");

        foreach (var field in _customFields.Where(f => f.EditorType == EntityEditorType.HtmlEditor))
        {
            if (_htmlEditors.TryGetValue(field.FieldId, out var editor) && editor != null)
            {
                try
                {
                    var html = await editor.GetHtml();
                    _customFieldValues[field.FieldId] = html ?? string.Empty;
                }
                catch (Exception ex)
                {
                    await logger.LogWarning(ex, "Unable to get HTML content for field {FieldId}: {Error}", field.FieldId, ex.Message);
                }
            }
        }
    }


    private void SyncCustomFieldValuesToDictionary()
    {
        // Sync bool values back to the string dictionary only for checkbox/toggle fields
        foreach (var field in _customFields.Where(f => f.EditorType == EntityEditorType.Checkbox || f.EditorType == EntityEditorType.Toggle))
        {
            if (_customFieldBoolValues.TryGetValue(field.FieldId, out var boolValue))
            {
                _customFieldValues[field.FieldId] = boolValue.ToString();
            }
        }
    }

    private void TryLoadCustomFieldValues(string settingsJson)
    {
        try
        {
            var values = JsonSerializer.Deserialize<Dictionary<int, string>>(settingsJson);
            if (values != null)
            {
                // Merge saved values into existing dictionaries (preserve initialized keys)
                foreach (var entry in values)
                {
                    _customFieldValues[entry.Key] = entry.Value;

                    // Also load bool values from the string dictionary
                    if (_customFieldBoolValues.ContainsKey(entry.Key))
                    {
                        if (bool.TryParse(entry.Value, out var boolValue))
                        {
                            _customFieldBoolValues[entry.Key] = boolValue;
                        }
                    }
                }
            }
        }
        catch
        {
            // ignore invalid custom field payloads in Settings
        }
    }

    private async Task LoadCustomFieldValuesAsync(int entityId)
    {
        try
        {
            var allValues = await EntityValueService.GetAllEntityValuesAsync(entityId);
            await logger.LogInformation($"LoadCustomFieldValuesAsync({entityId}) - Retrieved {allValues.Count} EntityValue records from database");

            // Build a comprehensive field lookup that includes fields from entire type hierarchy
            // This ensures we can find field definitions even if the entity's type was a parent type when values were saved
            var allFieldsLookup = new Dictionary<int, EntityField>();
            var effectiveTypeIds = GetEffectiveEntityTypeIds(_entityTypeId);
            await logger.LogInformation($"  Effective type IDs for EntityType {_entityTypeId}: [{string.Join(", ", effectiveTypeIds)}]");

            foreach (var typeId in effectiveTypeIds)
            {
                var fields = await EntityFieldService.GetFieldsAsync(typeId, ModuleState.ModuleId);
                await logger.LogInformation($"  Type {typeId}: {fields.Count} fields total, {fields.Count(f => f.IsEnabled)} enabled");
                foreach (var field in fields.Where(f => f.IsEnabled))
                {
                    if (!allFieldsLookup.ContainsKey(field.FieldId))
                    {
                        allFieldsLookup[field.FieldId] = field;
                        if (field.EditorType == EntityEditorType.HtmlEditor)
                        {
                            await logger.LogInformation($"    - Found HtmlEditor field {field.FieldId}: {field.Name}");
                        }
                    }
                }
            }
            await logger.LogInformation($"  Total unique fields in hierarchy: {allFieldsLookup.Count}");

            foreach (var fieldGroup in allValues.GroupBy(ev => ev.FieldId))
            {
                var storedFieldId = fieldGroup.Key;

                // Try to find stored field definition from hierarchy
                var field = _customFields.FirstOrDefault(cf => cf.FieldId == storedFieldId);
                if (field == null && allFieldsLookup.TryGetValue(storedFieldId, out var hierarchyField))
                {
                    field = hierarchyField;
                    await logger.LogDebug($"  FieldId {storedFieldId}: Found in hierarchy lookup (not in current _customFields)");
                }

                if (field == null)
                {
                    await logger.LogWarning($"  FieldId {storedFieldId}: Not found in any field list, skipping");
                    continue;
                }

                // Map stored values to the active rendered field id by Key when ids differ between parent/child types
                var targetField = _customFields.FirstOrDefault(cf => string.Equals(cf.Key, field.Key, StringComparison.OrdinalIgnoreCase)) ?? field;
                var targetFieldId = targetField.FieldId;

                if (targetFieldId != storedFieldId)
                {
                    await logger.LogInformation($"  Mapping stored FieldId {storedFieldId} ({field.Key}) to active FieldId {targetFieldId}");
                }

                var values = fieldGroup.OrderBy(v => v.ValueIndex).ToList();

                if (targetField.EditorType == EntityEditorType.HtmlEditor)
                {
                    await logger.LogInformation($"  FieldId {targetFieldId} ({targetField.Name}) - HtmlEditor: {values.Count} values from database");
                }
                else
                {
                    await logger.LogDebug($"  FieldId {targetFieldId} ({targetField.Name}): {values.Count} values, IsMultiValue: {targetField.IsMultiValue}");
                }

                if (targetField.IsMultiValue)
                {
                    var stringValues = values.Select(v => GetStringValueFromEntityValue(v)).ToList();
                    _customFieldValues[targetFieldId] = string.Join(",", stringValues);
                    await logger.LogDebug($"    Multi-value result: {_customFieldValues[targetFieldId]}");
                }
                else if (values.Any())
                {
                    var firstValue = values.First();

                    if (targetField.EditorType == EntityEditorType.Checkbox || targetField.EditorType == EntityEditorType.Toggle)
                    {
                        _customFieldBoolValues[targetFieldId] = firstValue.BooleanValue ?? false;
                        await logger.LogDebug($"    Boolean value set to: {_customFieldBoolValues[targetFieldId]}");
                    }
                    else
                    {
                        var stringValue = GetStringValueFromEntityValue(firstValue);
                        _customFieldValues[targetFieldId] = stringValue;

                        if (targetField.EditorType == EntityEditorType.HtmlEditor)
                        {
                            await logger.LogInformation($"    HtmlEditor value loaded: Length={stringValue?.Length ?? 0}, Content preview: {(string.IsNullOrEmpty(stringValue) ? "[EMPTY]" : stringValue.Substring(0, Math.Min(100, stringValue.Length)))}...");
                        }
                        else
                        {
                            await logger.LogDebug($"    String value set to: {stringValue}");
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            await logger.LogWarning(ex, "Unable to load EntityValue data, falling back to settings. {Error}", ex.Message);
            // Fallback to Settings for migration period
            if (!string.IsNullOrWhiteSpace(_settings))
            {
                TryLoadCustomFieldValues(_settings);
            }
        }
    }

    private async Task SaveCustomFieldValuesAsync(int entityId)
    {
        try
        {
            await logger.LogInformation($"=== SaveCustomFieldValuesAsync START ===");
            await logger.LogInformation($"EntityId: {entityId}, Total custom fields: {_customFields.Count}");
            await logger.LogInformation($"_customFieldValues dictionary contents BEFORE processing:");
            foreach (var kvp in _customFieldValues)
            {
                await logger.LogInformation($"  [{kvp.Key}] = '{kvp.Value}'");
            }

            var entitiesToSave = new List<EntityValue>();

            // IMPORTANT: Process fields from the entire hierarchy, not just current type
            // This ensures parent type fields are preserved when changing to a child type
            var effectiveTypeIds = GetEffectiveEntityTypeIds(_entityTypeId);
            var allFieldsFromHierarchy = new Dictionary<int, EntityField>();

            foreach (var typeId in effectiveTypeIds)
            {
                var fields = await EntityFieldService.GetFieldsAsync(typeId, ModuleState.ModuleId);
                foreach (var field in fields.Where(f => f.IsEnabled))
                {
                    if (!allFieldsFromHierarchy.ContainsKey(field.FieldId))
                    {
                        allFieldsFromHierarchy[field.FieldId] = field;
                    }
                }
            }

            // Also process fields from current type
            foreach (var field in _customFields)
            {
                if (!allFieldsFromHierarchy.ContainsKey(field.FieldId))
                {
                    allFieldsFromHierarchy[field.FieldId] = field;
                }
            }

            // Load existing values to preserve those from parent types that aren't being edited
            var existingValues = await EntityValueService.GetAllEntityValuesAsync(entityId);
            var existingValuesByFieldId = existingValues.GroupBy(ev => ev.FieldId)
                .ToDictionary(g => g.Key, g => g.ToList());

            // Process all fields from the hierarchy
            foreach (var field in allFieldsFromHierarchy.Values)
            {
                if (!_customFieldValues.ContainsKey(field.FieldId))
                {
                    // Field not in current edit form - preserve existing values if any
                    if (existingValuesByFieldId.TryGetValue(field.FieldId, out var existingFieldValues))
                    {
                        await logger.LogInformation($"Preserving field {field.FieldId} ({field.Name}) - {existingFieldValues.Count} existing values");
                        entitiesToSave.AddRange(existingFieldValues);
                    }
                    continue;
                }

                var stringValue = _customFieldValues[field.FieldId];
                var boolValue = _customFieldBoolValues.ContainsKey(field.FieldId) 
                    ? _customFieldBoolValues[field.FieldId] 
                    : false;

                await logger.LogDebug($"Processing field {field.FieldId} ({field.Name}): EditorType={field.EditorType}, Value={stringValue}, IsEmpty={string.IsNullOrWhiteSpace(stringValue)}");

                if (field.EditorType == EntityEditorType.Checkbox || field.EditorType == EntityEditorType.Toggle)
                {
                    if (boolValue)
                    {
                        var entityValue = new EntityValue
                        {
                            EntityId = entityId,
                            FieldId = field.FieldId,
                            ValueIndex = 0,
                            BooleanValue = boolValue
                        };
                        entitiesToSave.Add(entityValue);
                    }
                }
                else if (field.EditorType == EntityEditorType.ImageUpload || field.EditorType == EntityEditorType.FileUpload)
                {
                    // Explicitly handle ImageUpload/FileUpload fields - supports both single and multiple files
                    // For multi-value fields, we store an array of JSON objects: [{"fileId":1,...}, {"fileId":2,...}]
                    // For single-value fields, we store a single JSON object: {"fileId":1,...}
                    await logger.LogInformation($"ImageUpload field {field.FieldId}: Raw value = '{stringValue}'");

                    if (!string.IsNullOrWhiteSpace(stringValue))
                    {
                        if (field.IsMultiValue)
                        {
                            // For multi-value ImageUpload, expect JSON array format
                            await logger.LogInformation($"Processing multi-value ImageUpload field {field.FieldId}");

                            try
                            {
                                if (stringValue.StartsWith("[") && stringValue.EndsWith("]"))
                                {
                                    // Parse as JSON array of image objects
                                    var imageArray = JsonSerializer.Deserialize<List<object>>(stringValue);
                                    if (imageArray != null && imageArray.Count > 0)
                                    {
                                        int valueIndex = 0;
                                        foreach (var imageObj in imageArray)
                                        {
                                            var imageJson = imageObj.ToString();
                                            if (!string.IsNullOrWhiteSpace(imageJson))
                                            {
                                                var entityValue = ConvertToEntityValue(entityId, field, valueIndex, imageJson);
                                                if (entityValue != null)
                                                {
                                                    await logger.LogInformation($"ImageUpload multi-value EntityValue created - FieldId: {entityValue.FieldId}, ValueIndex: {valueIndex}, TextValue: {entityValue.TextValue}");
                                                    entitiesToSave.Add(entityValue);
                                                }
                                                valueIndex++;
                                            }
                                        }
                                    }
                                }
                                else
                                {
                                    // Fallback: treat as single image and wrap in array
                                    var entityValue = ConvertToEntityValue(entityId, field, 0, stringValue);
                                    if (entityValue != null)
                                    {
                                        await logger.LogInformation($"ImageUpload EntityValue created - FieldId: {entityValue.FieldId}, TextValue: {entityValue.TextValue}");
                                        entitiesToSave.Add(entityValue);
                                    }
                                }
                            }
                            catch (Exception ex)
                            {
                                await logger.LogWarning($"Error parsing multi-value ImageUpload field {field.FieldId}: {ex.Message}");
                                // Fallback: treat as single value
                                var entityValue = ConvertToEntityValue(entityId, field, 0, stringValue);
                                if (entityValue != null)
                                {
                                    entitiesToSave.Add(entityValue);
                                }
                            }
                        }
                        else
                        {
                            // Single-value ImageUpload
                            var entityValue = ConvertToEntityValue(entityId, field, 0, stringValue);

                            if (entityValue != null)
                            {
                                await logger.LogInformation($"ImageUpload EntityValue created - FieldId: {entityValue.FieldId}, TextValue: {entityValue.TextValue}");
                                entitiesToSave.Add(entityValue);
                            }
                            else
                            {
                                await logger.LogWarning($"ImageUpload ConvertToEntityValue returned null for field {field.FieldId}");
                            }
                        }
                    }
                    else
                    {
                        await logger.LogDebug($"ImageUpload field {field.FieldId} is empty, skipping");
                    }
                }
                else if (!string.IsNullOrWhiteSpace(stringValue))
                {
                    if (field.IsMultiValue)
                    {
                        // Split comma-separated values
                        var values = stringValue.Split(',', StringSplitOptions.RemoveEmptyEntries)
                            .Select(v => v.Trim())
                            .ToList();

                        int valueIndex = 0;
                        foreach (var value in values)
                        {
                            var entityValue = ConvertToEntityValue(entityId, field, valueIndex, value);
                            if (entityValue != null)
                            {
                                entitiesToSave.Add(entityValue);
                            }
                            valueIndex++;
                        }
                    }
                    else
                    {
                        var entityValue = ConvertToEntityValue(entityId, field, 0, stringValue);
                        if (entityValue != null)
                        {
                            entitiesToSave.Add(entityValue);
                        }
                    }
                }
            }

            if (entitiesToSave.Any())
            {
                await logger.LogInformation($"Saving {entitiesToSave.Count} EntityValues for Entity {entityId}");
                foreach (var ev in entitiesToSave)
                {
                    await logger.LogDebug($"  - FieldId: {ev.FieldId}, TextValue: {ev.TextValue}, IntValue: {ev.IntegerValue}, BoolValue: {ev.BooleanValue}");
                }
                await EntityValueService.ReplaceAllEntityValuesAsync(entityId, entitiesToSave);
                await logger.LogInformation($"Successfully saved {entitiesToSave.Count} EntityValues for Entity {entityId}");
            }
            else
            {
                await logger.LogInformation($"No custom field values to save for Entity {entityId}");
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error saving custom field values for entity {EntityId}: {Error}", entityId, ex.Message);
            // Don't rethrow - allow save to continue even if EntityValue save fails
        }
    }

    private EntityValue? ConvertToEntityValue(int entityId, EntityField field, int valueIndex, string stringValue)
    {
        if (string.IsNullOrWhiteSpace(stringValue))
            return null;

        var entityValue = new EntityValue
        {
            EntityId = entityId,
            FieldId = field.FieldId,
            ValueIndex = valueIndex
        };

        try
        {
            switch (field.DataType)
            {
                case EntityDataType.String:
                case EntityDataType.Guid:
                case EntityDataType.Json:
                    entityValue.TextValue = stringValue;
                    break;

                case EntityDataType.Integer:
                    if (int.TryParse(stringValue, out var intValue))
                    {
                        entityValue.IntegerValue = intValue;
                    }
                    else
                    {
                        entityValue.TextValue = stringValue; // Fallback
                    }
                    break;

                case EntityDataType.Long:
                    if (long.TryParse(stringValue, out var longValue))
                    {
                        entityValue.LongValue = longValue;
                    }
                    else
                    {
                        entityValue.TextValue = stringValue; // Fallback
                    }
                    break;

                case EntityDataType.Decimal:
                    if (decimal.TryParse(stringValue, out var decimalValue))
                    {
                        entityValue.DecimalValue = decimalValue;
                    }
                    else
                    {
                        entityValue.TextValue = stringValue; // Fallback
                    }
                    break;

                case EntityDataType.Boolean:
                    if (bool.TryParse(stringValue, out var boolValue))
                    {
                        entityValue.BooleanValue = boolValue;
                    }
                    else
                    {
                        entityValue.TextValue = stringValue; // Fallback
                    }
                    break;

                case EntityDataType.Date:
                    if (DateTime.TryParse(stringValue, out var dateValue))
                    {
                        entityValue.DateValue = dateValue;
                    }
                    else
                    {
                        entityValue.TextValue = stringValue; // Fallback
                    }
                    break;

                case EntityDataType.DateTime:
                    if (DateTime.TryParse(stringValue, out var dateTimeValue))
                    {
                        entityValue.DateTimeValue = dateTimeValue;
                    }
                    else
                    {
                        entityValue.TextValue = stringValue; // Fallback
                    }
                    break;

                default:
                    entityValue.TextValue = stringValue;
                    break;
            }
        }
        catch
        {
            // If conversion fails, store as text
            entityValue.TextValue = stringValue;
        }

        return entityValue;
    }

    private string GetStringValueFromEntityValue(EntityValue entityValue)
    {
        if (entityValue.TextValue != null) return entityValue.TextValue;
        if (entityValue.IntegerValue.HasValue) return entityValue.IntegerValue.Value.ToString();
        if (entityValue.LongValue.HasValue) return entityValue.LongValue.Value.ToString();
        if (entityValue.DecimalValue.HasValue) return entityValue.DecimalValue.Value.ToString();
        if (entityValue.BooleanValue.HasValue) return entityValue.BooleanValue.Value.ToString();
        if (entityValue.DateValue.HasValue) return entityValue.DateValue.Value.ToString("yyyy-MM-dd");
        if (entityValue.DateTimeValue.HasValue) return entityValue.DateTimeValue.Value.ToString("yyyy-MM-ddTHH:mm");
        if (entityValue.GuidValue.HasValue) return entityValue.GuidValue.Value.ToString();
        if (entityValue.ReferencedEntityId.HasValue) return entityValue.ReferencedEntityId.Value.ToString();

        return string.Empty;
    }

    private string BuildSettingsWithCustomFields()
    {
        return _customFieldValues.Any()
            ? JsonSerializer.Serialize(_customFieldValues)
            : "{}";
    }

    private List<EntityType> BuildEntityTypeTree(List<EntityType> flatList)
    {
        foreach (var item in flatList)
        {
            item.Children = new List<EntityType>();
        }

        var lookup = flatList.ToDictionary(x => x.EntityTypeId);
        var rootItems = new List<EntityType>();

        foreach (var item in flatList)
        {
            if (item.ParentEntityTypeId == null || !lookup.ContainsKey(item.ParentEntityTypeId.Value))
            {
                rootItems.Add(item);
            }
            else
            {
                lookup[item.ParentEntityTypeId.Value].Children.Add(item);
            }
        }

        SortEntityTypes(rootItems);
        return rootItems;
    }

    private void SortEntityTypes(List<EntityType> items)
    {
        items.Sort((a, b) => a.SortOrder.CompareTo(b.SortOrder));
        foreach (var item in items)
        {
            if (item.Children != null && item.Children.Count > 0)
            {
                SortEntityTypes(item.Children);
            }
        }
    }

    private RenderFragment RenderEntityTypeOptions(IEnumerable<EntityType> items, int level = 0) => builder =>
    {
        int seq = 0;
        foreach (var item in items)
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", item.EntityTypeId);
            builder.AddContent(seq++, new string('\u00A0', level * 4) + item.Name); // Indent with non-breaking spaces
            builder.CloseElement();

            if (item.Children != null && item.Children.Count > 0)
            {
                builder.AddContent(seq++, RenderEntityTypeOptions(item.Children, level + 1));
            }
        }
    };

    private async Task Save()
    {
        try
        {
            validated = true;
            var interop = new Oqtane.UI.Interop(JSRuntime);
            if (await interop.FormValid(form))
            {
                await SyncHtmlEditorValuesAsync();
                SyncCustomFieldValuesToDictionary();

                Entity? savedEntity = null;

                if (PageState.Action == "Add")
                {
                    Entity Entity = new Entity();
                    Entity.SiteId = PageState.Site.SiteId;
                    Entity.ModuleId = ModuleState.ModuleId;
                    Entity.EntityTypeId = _entityTypeId;
                    Entity.Name = _name;
                    Entity.Key = string.IsNullOrWhiteSpace(_key) ? null : _key;
                    Entity.Description = string.IsNullOrWhiteSpace(_description) ? null : _description;
                    Entity.ParentEntityId = string.IsNullOrWhiteSpace(_parentEntityId) ? null : int.Parse(_parentEntityId);
                    Entity.Status = string.IsNullOrWhiteSpace(_status) ? null : _status;
                    Entity.SortOrder = _sortOrder;
                    Entity.IsEnabled = bool.Parse(_isEnabled);
                    Entity.IsFeatured = bool.Parse(_isFeatured);
                    Entity.IsPublished = bool.Parse(_isPublished);
                    Entity.PublishStartDate = _publishStartDate;
                    Entity.PublishEndDate = _publishEndDate;
                    Entity.Settings = "{}"; // Clear settings, use EntityValue instead
                    savedEntity = await ClientEntityService.AddEntityAsync(Entity);
                    await logger.LogInformation("Entity Added {Entity}", savedEntity);
                }
                else
                {
                    Entity Entity = await ClientEntityService.GetEntityAsync(_id, ModuleState.ModuleId);
                    Entity.EntityTypeId = _entityTypeId;
                    Entity.Name = _name;
                    Entity.Key = string.IsNullOrWhiteSpace(_key) ? null : _key;
                    Entity.Description = string.IsNullOrWhiteSpace(_description) ? null : _description;
                    Entity.ParentEntityId = string.IsNullOrWhiteSpace(_parentEntityId) ? null : int.Parse(_parentEntityId);
                    Entity.Status = string.IsNullOrWhiteSpace(_status) ? null : _status;
                    Entity.SortOrder = _sortOrder;
                    Entity.IsEnabled = bool.Parse(_isEnabled);
                    Entity.IsFeatured = bool.Parse(_isFeatured);
                    Entity.IsPublished = bool.Parse(_isPublished);
                    Entity.PublishStartDate = _publishStartDate;
                    Entity.PublishEndDate = _publishEndDate;
                    Entity.Settings = "{}"; // Clear settings, use EntityValue instead
                    await ClientEntityService.UpdateEntityAsync(Entity);
                    savedEntity = Entity;
                    await logger.LogInformation("Entity Updated {Entity}", savedEntity);
                }

                // Save custom field values to EntityValue table
                if (savedEntity != null)
                {
                    await SaveCustomFieldValuesAsync(savedEntity.EntityId);

                    // Always clear featured cache after save to prevent stale template output
                    Index.ClearFeaturedCache(ModuleState.ModuleId);
                    await logger.LogDebug($"Cleared featured cache for module {ModuleState.ModuleId}");
                }

                NavigationManager.NavigateTo(NavigateUrl(ModuleState.ModuleId, "EntityList"));
            }
            else
            {
                AddModuleMessage(Localizer["Message.SaveValidation"], MessageType.Warning);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Saving Entity {Error}", ex.Message);
            AddModuleMessage(Localizer["Message.SaveError"], MessageType.Error);
        }
    }

