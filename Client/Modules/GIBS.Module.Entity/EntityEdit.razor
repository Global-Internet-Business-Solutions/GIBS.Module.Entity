    private async Task OnEntityTypeChanged()
    {
        await logger.LogInformation($"OnEntityTypeChanged called - EntityTypeId: {_entityTypeId}, EntityId: {_id}");

        // CRITICAL: Sync HTML editors BEFORE reloading fields
        // This preserves any content that was entered in the HTML editors
        await SyncHtmlEditorValuesAsync();

        // Store current values to preserve them across the field reload
        var previousValues = new Dictionary<int, string>(_customFieldValues);
        var previousBoolValues = new Dictionary<int, bool>(_customFieldBoolValues);

        await LoadCustomFieldsAsync();
        await logger.LogInformation($"After LoadCustomFieldsAsync - _customFields.Count: {_customFields.Count}");

        // Restore the preserved values (especially important for HTML editors that were just synced)
        foreach (var kvp in previousValues)
        {
            _customFieldValues[kvp.Key] = kvp.Value;
        }
        foreach (var kvp in previousBoolValues)
        {
            _customFieldBoolValues[kvp.Key] = kvp.Value;
        }

        // If editing an existing entity, load values from database ONLY for fields not yet populated
        // This handles fields that are new to the child type
        if (PageState.Action == "Edit" && _id > 0)
        {
            try
            {
                var dbValues = await EntityValueService.GetAllEntityValuesAsync(_id);
                await logger.LogInformation($"Loading missing fields from database - Retrieved {dbValues.Count} EntityValue records");

                // Build field lookup
                var allFieldsLookup = new Dictionary<int, EntityField>();
                var effectiveTypeIds = GetEffectiveEntityTypeIds(_entityTypeId);

                foreach (var typeId in effectiveTypeIds)
                {
                    var fields = await EntityFieldService.GetFieldsAsync(typeId, ModuleState.ModuleId);
                    foreach (var field in fields.Where(f => f.IsEnabled))
                    {
                        if (!allFieldsLookup.ContainsKey(field.FieldId))
                        {
                            allFieldsLookup[field.FieldId] = field;
                        }
                    }
                }

                // Load database values ONLY for fields that don't have values yet
                foreach (var fieldGroup in dbValues.GroupBy(ev => ev.FieldId))
                {
                    var fieldId = fieldGroup.Key;

                    // Skip if we already have a value for this field (from sync or previous state)
                    if (_customFieldValues.ContainsKey(fieldId) && !string.IsNullOrEmpty(_customFieldValues[fieldId]))
                    {
                        await logger.LogDebug($"  FieldId {fieldId}: Already has value, skipping database load");
                        continue;
                    }

                    var field = _customFields.FirstOrDefault(cf => cf.FieldId == fieldId);
                    if (field == null && allFieldsLookup.TryGetValue(fieldId, out var hierarchyField))
                    {
                        field = hierarchyField;
                    }

                    if (field == null)
                    {
                        await logger.LogWarning($"  FieldId {fieldId}: Field not found, skipping");
                        continue;
                    }

                    var values = fieldGroup.OrderBy(v => v.ValueIndex).ToList();
                    await logger.LogInformation($"  Loading FieldId {fieldId}: {values.Count} values from database");

                    if (field.IsMultiValue)
                    {
                        var stringValues = values.Select(v => GetStringValueFromEntityValue(v)).ToList();
                        _customFieldValues[fieldId] = string.Join(",", stringValues);
                        await logger.LogDebug($"    Multi-value: {_customFieldValues[fieldId]}");
                    }
                    else if (values.Any())
                    {
                        var firstValue = values.First();

                        if (field.EditorType == EntityEditorType.Checkbox || field.EditorType == EntityEditorType.Toggle)
                        {
                            _customFieldBoolValues[fieldId] = firstValue.BooleanValue ?? false;
                        }
                        else
                        {
                            _customFieldValues[fieldId] = GetStringValueFromEntityValue(firstValue);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                await logger.LogWarning(ex, "Error loading missing field values from database: {Error}", ex.Message);
            }
        }

        var allEntities = await ClientEntityService.GetEntitysAsync(ModuleState.ModuleId);
        if (PageState.Action == "Edit")
        {
            _availableParentEntities = allEntities.Where(e => e.EntityId != _id && e.EntityTypeId == _entityTypeId).ToList();
        }
        else
        {
            _availableParentEntities = allEntities.Where(e => e.EntityTypeId == _entityTypeId).ToList();
        }

        _htmlEditorRenderVersion++;

        // Force Blazor to re-render with the new state
        StateHasChanged();
    }

    private async Task LoadCustomFieldsAsync()
    {
        _customFields = new List<EntityField>();
        _customFieldOptions = new Dictionary<int, List<EntityFieldOption>>();
        _customFieldValues = new Dictionary<int, string>();
        _customFieldBoolValues = new Dictionary<int, bool>();
        _htmlEditors = new Dictionary<int, RichTextEditor>();

        if (_entityTypeId <= 0)
        {
            return;
        }

        var effectiveTypeIds = GetEffectiveEntityTypeIds(_entityTypeId);
        var fieldsByKey = new Dictionary<string, EntityField>(StringComparer.OrdinalIgnoreCase);

        foreach (var typeId in effectiveTypeIds)
        {
            var fields = await EntityFieldService.GetFieldsAsync(typeId, ModuleState.ModuleId);
            foreach (var field in fields.Where(f => f.IsEnabled))
            {
                if (!fieldsByKey.ContainsKey(field.Key))
                {
                    fieldsByKey[field.Key] = field;
                }
            }
        }

        _customFields = fieldsByKey.Values.OrderBy(f => f.SortOrder).ThenBy(f => f.Name).ToList();

        foreach (var field in _customFields)
        {
            // Initialize dictionary entries for all fields
            if (!_customFieldValues.ContainsKey(field.FieldId))
            {
                _customFieldValues[field.FieldId] = string.Empty;
            }
            if (!_customFieldBoolValues.ContainsKey(field.FieldId))
            {
                _customFieldBoolValues[field.FieldId] = false;
            }

            // Set default values if provided
            if (!string.IsNullOrWhiteSpace(field.DefaultValue))
            {
                if (field.EditorType == EntityEditorType.Checkbox || field.EditorType == EntityEditorType.Toggle)
                {
                    if (bool.TryParse(field.DefaultValue, out var boolValue))
                    {
                        _customFieldBoolValues[field.FieldId] = boolValue;
                    }
                }
                else
                {
                    _customFieldValues[field.FieldId] = field.DefaultValue;
                }
            }

            if (field.EditorType == EntityEditorType.Dropdown ||
                field.EditorType == EntityEditorType.RadioList ||
                field.EditorType == EntityEditorType.CheckboxList ||
                field.EditorType == EntityEditorType.MultiSelect)
            {
                var options = await EntityFieldOptionService.GetFieldOptionsAsync(field.FieldId, ModuleState.ModuleId);
                _customFieldOptions[field.FieldId] = options.Where(o => o.IsEnabled).OrderBy(o => o.SortOrder).ThenBy(o => o.DisplayText).ToList();
            }

            if (field.EditorType == EntityEditorType.HtmlEditor)
            {
                _htmlEditors[field.FieldId] = null;
            }
        }
    }

    private List<int> GetEffectiveEntityTypeIds(int entityTypeId)
    {
        var result = new List<int>();
        var currentId = entityTypeId;
        var seen = new HashSet<int>();

        while (currentId > 0 && _entityTypeLookup.TryGetValue(currentId, out var entityType) && seen.Add(currentId))
        {
            result.Add(currentId);
            currentId = entityType.ParentEntityTypeId ?? 0;
        }

        return result;
    }

    private List<EntityFieldOption> GetFieldOptions(int fieldId)
    {
        return _customFieldOptions.TryGetValue(fieldId, out var options)
            ? options
            : new List<EntityFieldOption>();
    }

    private string GetCustomFieldValue(int fieldId, string defaultValue = null)
    {
        if (_customFieldValues.TryGetValue(fieldId, out var value))
        {
            return value ?? string.Empty;
        }

        return defaultValue ?? string.Empty;
    }

    /// <summary>
    /// Extract file path from ImageUpload field value (stored as JSON)
    /// Handles both new JSON format: {"fileId": 123, "filePath": "/path/to/image.jpg"}
    /// And legacy path-only format for backward compatibility
    /// </summary>
    private string GetImagePathFromField(int fieldId)
    {
        var value = GetCustomFieldValue(fieldId, "");

        if (string.IsNullOrEmpty(value))
            return string.Empty;

        try
        {
            // Try to parse as JSON first (new format)
            if (value.StartsWith("{") && value.EndsWith("}"))
            {
                var imageData = JsonSerializer.Deserialize<Dictionary<string, object>>(value);
                if (imageData != null && imageData.TryGetValue("filePath", out var filePath))
                {
                    return filePath?.ToString() ?? string.Empty;
                }
            }
        }
        catch
        {
            // If JSON parsing fails, treat as legacy path-only value
        }

        // Fallback: treat as direct path (backward compatibility)
        return value;
    }

    /// <summary>
    /// Extract all file paths from ImageUpload field value
    /// Handles both single image JSON and multi-value array formats
    /// Also handles legacy format where multiple JSON objects are concatenated
    /// </summary>
    private List<string> GetAllImagePathsFromField(int fieldId)
    {
        var paths = new List<string>();
        var value = GetCustomFieldValue(fieldId, "");

        if (string.IsNullOrEmpty(value))
            return paths;

        try
        {
            // Try array format first (multi-value with proper JSON array)
            if (value.StartsWith("[") && value.EndsWith("]"))
            {
                var imageArray = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(value);
                if (imageArray != null)
                {
                    foreach (var imageObj in imageArray)
                    {
                        if (imageObj != null && imageObj.TryGetValue("filePath", out var filePath))
                        {
                            var path = filePath?.ToString();
                            if (!string.IsNullOrEmpty(path))
                                paths.Add(path);
                        }
                    }
                }
                return paths;
            }

            // Handle legacy format: {"fileId":12,"filePath":"..."}, {"fileId":10,"filePath":"..."}
            // (multiple JSON objects concatenated without array brackets)
            if (value.StartsWith("{"))
            {
                // Try to split by }, { and reconstruct as array
                var correctedValue = value.Replace("}, {", "},{");
                if (!correctedValue.StartsWith("["))
                    correctedValue = "[" + correctedValue + "]";

                try
                {
                    var legacyImageArray = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(correctedValue);
                    if (legacyImageArray != null)
                    {
                        foreach (var imageObj in legacyImageArray)
                        {
                            if (imageObj != null && imageObj.TryGetValue("filePath", out var legacyFilePath))
                            {
                                var path = legacyFilePath?.ToString();
                                if (!string.IsNullOrEmpty(path))
                                    paths.Add(path);
                            }
                        }
                        return paths;
                    }
                }
                catch
                {
                    // If array reconstruction fails, try single object
                }

                // Try single object format
                var imageData = JsonSerializer.Deserialize<Dictionary<string, object>>(value);
                if (imageData != null && imageData.TryGetValue("filePath", out var filePath))
                {
                    var path = filePath?.ToString();
                    if (!string.IsNullOrEmpty(path))
                        paths.Add(path);
                }
                return paths;
            }
        }
        catch (Exception ex)
        {
            // If JSON parsing fails, treat as legacy path-only value
            System.Diagnostics.Debug.WriteLine($"Error parsing image paths: {ex.Message}");
        }

        // Fallback: treat as direct path (backward compatibility)
        if (!string.IsNullOrEmpty(value))
            paths.Add(value);

        return paths;
    }

    /// <summary>
