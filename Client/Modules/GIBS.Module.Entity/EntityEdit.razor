    private bool validated = false;

    private int _id;
    private int _entityTypeId;
    private string _name = string.Empty;
    private string _key = string.Empty;
    private string _description = string.Empty;
    private string _parentEntityId = string.Empty;
    private string _status = StatusDraft;
    private int _sortOrder = 0;
    private string _isEnabled = "True";
    private string _isFeatured = "False";
    private string _isPublished = "False";
    private DateTime? _publishStartDate;
    private DateTime? _publishEndDate;
    private string _settings = string.Empty;
    private string _createdby;
    private DateTime _createdon;
    private string _modifiedby;
    private DateTime _modifiedon;
    private string _mode => PageState.Action == "Add" ? Localizer["Add"] : Localizer["Edit"];

    private const string StatusDraft = "Draft";
    private const string StatusPendingReview = "Pending Review";
    private const string StatusApproved = "Approved";
    private const string StatusPublished = "Published";
    private const string StatusArchived = "Archived";

    private static readonly IReadOnlyList<string> StatusOptions = new[]
    {
        StatusDraft,
        StatusPendingReview,
        StatusApproved,
        StatusPublished,
        StatusArchived
    };

    private List<EntityType> _entityTypes = new();
    private List<EntityType> _entityTypeTree = new();
    private List<Entity> _availableParentEntities = new();
    private List<EntityField> _customFields = new();
    private Dictionary<int, List<EntityFieldOption>> _customFieldOptions = new();
    private Dictionary<int, string> _customFieldValues = new();
    private Dictionary<int, bool> _customFieldBoolValues = new();
    private Dictionary<int, RichTextEditor> _htmlEditors = new();
    private Dictionary<int, EntityType> _entityTypeLookup = new();
    private int _htmlEditorRenderVersion = 0;

    // Image Upload Settings
    private int _fileFolderId = 1;
    private int _imageThumbWidth = 360;
    private int _imageThumbHeight = 360;
    private int _imageMaxWidth = 1600;
    private int _imageMaxHeight = 900;
    private bool _showPhotoTitle = true;
    private int _currentImageFieldId = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load entity types for dropdown
            _entityTypes = await EntityTypeService.GetEntityTypesAsync(PageState.Site.SiteId, ModuleState.ModuleId);
            _entityTypeTree = BuildEntityTypeTree(_entityTypes);
            _entityTypeLookup = _entityTypes.ToDictionary(x => x.EntityTypeId, x => x);

            if (PageState.Action == "Edit")
            {
                _id = Int32.Parse(PageState.QueryString["id"]);
                Entity Entity = await ClientEntityService.GetEntityAsync(_id, ModuleState.ModuleId);
                if (Entity != null)
                {
                    _entityTypeId = Entity.EntityTypeId;
                    _name = Entity.Name;
                    _key = Entity.Key ?? string.Empty;
                    _description = Entity.Description ?? string.Empty;
                    _parentEntityId = Entity.ParentEntityId?.ToString() ?? string.Empty;
                    _status = string.IsNullOrWhiteSpace(Entity.Status) ? StatusDraft : (StatusOptions.Contains(Entity.Status) ? Entity.Status : StatusDraft);
                    _sortOrder = Entity.SortOrder;
                    _isEnabled = Entity.IsEnabled.ToString();
                    _isFeatured = Entity.IsFeatured.ToString();
                    _isPublished = Entity.IsPublished.ToString();
                    _publishStartDate = Entity.PublishStartDate;
                    _publishEndDate = Entity.PublishEndDate;
                    _settings = Entity.Settings ?? string.Empty;
                    _createdby = Entity.CreatedBy;
                    _createdon = Entity.CreatedOn;
                    _modifiedby = Entity.ModifiedBy;
                    _modifiedon = Entity.ModifiedOn;

                    // Load potential parent entities (exclude self)
                    var allEntities = await ClientEntityService.GetEntitysAsync(ModuleState.ModuleId);
                    _availableParentEntities = allEntities.Where(e => e.EntityId != _id && e.EntityTypeId == _entityTypeId).ToList();
                }
            }
            else
            {
                // Load all entities for parent selection in Add mode
                var allEntities = await ClientEntityService.GetEntitysAsync(ModuleState.ModuleId);
                _availableParentEntities = allEntities.ToList();
            }

            // Load custom field definitions first
            await LoadCustomFieldsAsync();

            // Load image upload settings
            await LoadImageSettingsAsync();

            // Then load saved custom field values (Edit mode)
            if (PageState.Action == "Edit")
            {
                await LoadCustomFieldValuesAsync(_id);
                _htmlEditorRenderVersion++;
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading Entity {EntityId} {Error}", _id, ex.Message);
            AddModuleMessage(Localizer["Message.LoadError"], MessageType.Error);
        }
    }

